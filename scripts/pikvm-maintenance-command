#!/usr/bin/env python3
"""Unprivileged forced SSH command. No shell, arbitrary paths, input or GPIO."""
import json
import os
from pathlib import Path
import subprocess
import sys

COMMANDS=('status','services','version')
UNITS=('kvmd.service','kvmd-nginx.service','pikvm-portable-api.service','pikvm-oled-custom.service','pikvm-button-menu.service','pikvm-power-hold.service')
def execute(command):
    if command not in COMMANDS:raise ValueError('Commande refusée. Commandes : status, services, version. Aucun shell, transfert, sudo ou tunnel.')
    if command=='version':return {'protocol':1,'commands':COMMANDS,'privileged':False}
    if command=='status':
        memory={}
        for line in Path('/proc/meminfo').read_text().splitlines():
            key,value=line.split(':',1)
            if key in ('MemTotal','MemAvailable','SwapTotal','SwapFree'):memory[key]=int(value.split()[0])
        return {'memory_kib':memory,'uptime_seconds':float(Path('/proc/uptime').read_text().split()[0]),'load':os.getloadavg(),'uid':os.geteuid()}
    result=subprocess.run(['/usr/bin/systemctl','show','--no-pager','--property=Id,ActiveState,SubState,NRestarts',*UNITS],capture_output=True,text=True,timeout=8,env={'PATH':'/usr/bin','LC_ALL':'C'},stdin=subprocess.DEVNULL)
    if result.returncode:raise ValueError('Lecture des services indisponible.')
    return {'services':result.stdout[:12000]}

def main():
    if len(sys.argv)!=1 or os.geteuid()==0:raise ValueError('UID de maintenance non privilégié requis.')
    command=os.environ.get('SSH_ORIGINAL_COMMAND','')
    # Exact strings only; no shlex, shell=True, argv forwarding or stdin commands.
    print(json.dumps(execute(command)))

if __name__=='__main__':
    try:main()
    except (OSError,ValueError,subprocess.TimeoutExpired) as error:
        print(str(error),file=sys.stderr);raise SystemExit(126)
