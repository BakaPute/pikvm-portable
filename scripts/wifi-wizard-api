#!/usr/bin/env python3
import json
import os
import re
import shutil
import signal
import socketserver
import sys
import threading
import uuid
import importlib.machinery
import importlib.util
import subprocess
from datetime import datetime
from http.server import BaseHTTPRequestHandler
from pathlib import Path
from urllib.parse import urlparse

sys.path.insert(0, '/usr/local/lib/pikvm-portable')
import pikvm_transfer as transfer

CONF = Path("/etc/wpa_supplicant/wpa_supplicant-wlan0.conf")
FORCED_PRIORITY = "9999"
HOST = "127.0.0.1"
PORT = 9876


def run(cmd, check=False, input_text=None):
    if isinstance(cmd, str):
        return subprocess.run(cmd, shell=True, text=True, capture_output=True, check=check, timeout=30)
    return subprocess.run(cmd, text=True, input=input_text, capture_output=True, check=check, timeout=30)


def make_rw():
    if shutil.which("rw"):
        run(["rw"], check=True)


def make_ro():
    if shutil.which("ro"):
        run(["ro"], check=True)


def restart_wifi_service():
    if run(['systemctl', 'restart', 'wpa_supplicant@wlan0.service']).returncode:
        if run(['systemctl', 'restart', 'wpa_supplicant.service']).returncode:
            raise RuntimeError('Redémarrage Wi-Fi échoué ; sauvegarde de configuration conservée')


def backup_conf():
    backup = CONF.with_name(CONF.name + ".backup." + datetime.now().strftime("%Y%m%d-%H%M%S") + '-' + uuid.uuid4().hex)
    shutil.copy2(CONF, backup)
    backup.chmod(0o600)
    with backup.open('r+b') as handle:
        os.fsync(handle.fileno())
    transfer.fsync_dir(backup.parent)
    return str(backup)


def read_conf():
    if not CONF.exists():
        return []
    return CONF.read_text().splitlines()  # Corruption is an error, never silently discarded.


def write_conf(lines):
    temporary = CONF.with_name(CONF.name + '.' + uuid.uuid4().hex + '.new')
    try:
        if CONF.is_symlink():
            raise RuntimeError('Configuration Wi-Fi symbolique interdite')
        with temporary.open('x', encoding='utf-8') as handle:
            temporary.chmod(0o600)
            handle.write('\n'.join(lines) + '\n')
            handle.flush()
            os.fsync(handle.fileno())
        temporary.replace(CONF)
        transfer.fsync_dir(CONF.parent)
    finally:
        temporary.unlink(missing_ok=True)


def checked_priority(value):
    if not re.fullmatch(r'-?\d{1,5}', value) or not -9999 <= int(value) <= 9999:
        raise ValueError('Priorité Wi-Fi invalide')
    return str(int(value))


def generate_network(ssid, password):
    if not 1 <= len(ssid.encode('utf-8')) <= 32 or any(ord(c) < 32 for c in ssid):
        raise ValueError('SSID invalide')
    if not 8 <= len(password) <= 63 or any(ord(c) < 32 for c in password):
        raise ValueError('Mot de passe WPA invalide (8–63 caractères)')
    # Password is input, never an argv field or exception with command arguments.
    result = run(['wpa_passphrase', ssid], input_text=password + '\n')
    if result.returncode:
        raise RuntimeError('Génération de configuration WPA échouée')
    return result


def split_blocks(lines):
    items = []
    raw = []
    in_block = False
    block = []

    for line in lines:
        if not in_block and re.match(r"^\s*network\s*=\s*\{", line):
            if raw:
                items.append(("raw", raw))
                raw = []
            in_block = True
            block = [line]
        elif in_block:
            block.append(line)
            if re.match(r"^\s*\}", line):
                items.append(("network", block))
                in_block = False
                block = []
        else:
            raw.append(line)

    if block:
        items.append(("network", block))
    if raw:
        items.append(("raw", raw))

    return items


def get_value(block, key):
    pattern = re.compile(rf'^\s*{re.escape(key)}\s*=\s*"?([^"]*)"?\s*$')
    for line in block:
        m = pattern.match(line)
        if m:
            return m.group(1).strip()
    return ""


def get_comment_psk(block):
    for line in block:
        m = re.match(r'^\s*#psk\s*=\s*"([^"]*)"', line)
        if m:
            return m.group(1)
    return ""


def is_forced(block):
    return any("#wifi-wizard-forced=1" in line for line in block)


def get_old_priority(block):
    for line in block:
        m = re.match(r"^\s*#wifi-wizard-old-priority=(.*)$", line)
        if m:
            return m.group(1).strip()
    return ""


def get_networks():
    items = split_blocks(read_conf())
    nets = []
    idx = 0

    for kind, block in items:
        if kind != "network":
            continue

        idx += 1
        ssid = get_value(block, "ssid") or "<SSID inconnu>"
        priority = get_value(block, "priority") or "0"
        psk = get_comment_psk(block) or ""
        hidden = get_value(block, "scan_ssid") == "1"
        forced = is_forced(block)

        nets.append({
            "id": idx,
            "ssid": ssid,
            "password": psk,
            "password_visible": bool(psk),
            "priority": priority,
            "hidden": hidden,
            "forced": forced,
        })

    return nets


def clean_forced_markers(block):
    return [
        line for line in block
        if "#wifi-wizard-forced=1" not in line
        and not re.match(r"^\s*#wifi-wizard-old-priority=", line)
    ]


def remove_priority_lines(block):
    return [
        line for line in block
        if not re.match(r"^\s*priority\s*=", line)
    ]


def insert_before_closing(block, lines_to_insert):
    new_block = []
    inserted = False

    for line in block:
        if not inserted and re.match(r"^\s*\}", line):
            new_block.extend(lines_to_insert)
            inserted = True
        new_block.append(line)

    if not inserted:
        new_block.extend(lines_to_insert)

    return new_block


def wifi_status():
    link = run(["iw", "wlan0", "link"]).stdout.strip()
    ip_out = run("ip -4 addr show wlan0 | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}' | head -1").stdout.strip()

    status = {
        "connected": False,
        "ssid": "",
        "ip": ip_out,
        "signal": "",
        "raw": link,
    }

    for line in link.splitlines():
        line = line.strip()
        if line.startswith("SSID:"):
            status["connected"] = True
            status["ssid"] = line.replace("SSID:", "", 1).strip()
        elif line.startswith("signal:"):
            status["signal"] = line.replace("signal:", "", 1).strip()

    return status


def parse_signal(signal):
    m = re.search(r"(-?\d+)", signal or "")
    if not m:
        return -999
    return int(m.group(1))


def scan_wifi():
    result = run(["iw", "dev", "wlan0", "scan"])
    output = result.stdout

    networks = []
    current = None

    for line in output.splitlines():
        line = line.strip()

        if line.startswith("BSS "):
            if current and current.get("ssid"):
                networks.append(current)
            current = {"ssid": "", "signal": "", "security": "open"}

        elif current is not None and line.startswith("signal:"):
            current["signal"] = line.replace("signal:", "", 1).strip()

        elif current is not None and line.startswith("SSID:"):
            current["ssid"] = line.replace("SSID:", "", 1).strip()

        elif current is not None and ("RSN:" in line or "WPA:" in line):
            current["security"] = "secured"

    if current and current.get("ssid"):
        networks.append(current)

    merged = {}
    for net in networks:
        ssid = net["ssid"]
        if ssid not in merged:
            merged[ssid] = net
        else:
            old_sig = parse_signal(merged[ssid].get("signal", ""))
            new_sig = parse_signal(net.get("signal", ""))
            if new_sig > old_sig:
                merged[ssid] = net

    return sorted(merged.values(), key=lambda n: parse_signal(n.get("signal", "")), reverse=True)


def add_wifi(data):
    ssid = str(data.get("ssid", "")).strip()
    password = str(data.get("password", "")).strip()
    priority = checked_priority(str(data.get("priority", "10")).strip() or "10")
    hidden = bool(data.get("hidden", False))

    if not ssid:
        raise ValueError("SSID vide.")
    if not password:
        raise ValueError("Mot de passe vide.")

    result = generate_network(ssid, password)
    if result.returncode != 0:
        raise RuntimeError(result.stderr or "Erreur wpa_passphrase.")

    block = result.stdout.splitlines()
    new_block = []

    for line in block:
        if re.match(r"^\s*\}", line):
            if hidden:
                new_block.append("    scan_ssid=1")
            new_block.append(f"    priority={priority}")
        new_block.append(line)

    make_rw()
    try:
        backup_conf()
        lines = read_conf()
        lines.append("")
        lines.extend(new_block)
        write_conf(lines)
        restart_wifi_service()
    finally:
        make_ro()

    return {"message": f"Réseau ajouté : {ssid}"}


def delete_wifi(data):
    target = int(data.get("id", 0))
    nets = get_networks()

    if target < 1 or target > len(nets):
        raise ValueError("Réseau introuvable.")

    ssid = nets[target - 1]["ssid"]

    lines = read_conf()
    items = split_blocks(lines)

    new_lines = []
    net_index = 0

    for kind, block in items:
        if kind != "network":
            new_lines.extend(block)
            continue

        net_index += 1
        if net_index == target:
            continue

        new_lines.extend(block)

    make_rw()
    try:
        backup_conf()
        write_conf(new_lines)
        restart_wifi_service()
    finally:
        make_ro()

    return {"message": f"Réseau supprimé : {ssid}"}


def force_wifi(data):
    target = int(data.get("id", 0))
    nets = get_networks()

    if target < 1 or target > len(nets):
        raise ValueError("Réseau introuvable.")

    selected_ssid = nets[target - 1]["ssid"]

    lines = read_conf()
    items = split_blocks(lines)

    new_lines = []
    net_index = 0

    for kind, block in items:
        if kind != "network":
            new_lines.extend(block)
            continue

        net_index += 1
        current_priority = get_value(block, "priority")
        old_priority = get_old_priority(block)

        block = clean_forced_markers(block)
        block = remove_priority_lines(block)

        if net_index == target:
            block = insert_before_closing(block, [
                "    #wifi-wizard-forced=1",
                f"    #wifi-wizard-old-priority={current_priority}",
                f"    priority={FORCED_PRIORITY}",
            ])
        else:
            if old_priority != "":
                block = insert_before_closing(block, [
                    f"    priority={old_priority}",
                ])

        new_lines.extend(block)

    make_rw()
    try:
        backup_conf()
        write_conf(new_lines)
        restart_wifi_service()
    finally:
        make_ro()

    return {"message": f"Wi-Fi prioritaire : {selected_ssid}"}



def update_wifi(data):
    target = int(data.get("id", 0))
    ssid = str(data.get("ssid", "")).strip()
    password = str(data.get("password", "")).strip()
    priority = checked_priority(str(data.get("priority", "10")).strip() or "10")
    hidden = bool(data.get("hidden", False))

    nets = get_networks()

    if target < 1 or target > len(nets):
        raise ValueError("Réseau introuvable.")
    if not ssid:
        raise ValueError("SSID vide.")

    lines = read_conf()
    items = split_blocks(lines)

    old_block = None
    net_index = 0

    for kind, block in items:
        if kind != "network":
            continue
        net_index += 1
        if net_index == target:
            old_block = block
            break

    if old_block is None:
        raise ValueError("Bloc réseau introuvable.")

    old_ssid = get_value(old_block, "ssid")
    old_password = get_comment_psk(old_block)
    was_forced = is_forced(old_block)

    if not password:
        password = old_password

    if not password:
        raise ValueError("Mot de passe manquant. Entre un nouveau mot de passe.")

    result = generate_network(ssid, password)
    if result.returncode != 0:
        raise RuntimeError(result.stderr or "Erreur wpa_passphrase.")

    generated = result.stdout.splitlines()
    new_block = []

    for line in generated:
        if re.match(r"^\s*\}", line):
            if hidden:
                new_block.append("    scan_ssid=1")

            if was_forced:
                new_block.append("    #wifi-wizard-forced=1")
                new_block.append(f"    #wifi-wizard-old-priority={priority}")
                new_block.append(f"    priority={FORCED_PRIORITY}")
            else:
                new_block.append(f"    priority={priority}")

        new_block.append(line)

    new_lines = []
    net_index = 0

    for kind, block in items:
        if kind != "network":
            new_lines.extend(block)
            continue

        net_index += 1

        if net_index == target:
            new_lines.extend(new_block)
        else:
            new_lines.extend(block)

    make_rw()
    try:
        backup_conf()
        write_conf(new_lines)
        restart_wifi_service()
    finally:
        make_ro()

    return {"message": f"Réseau modifié : {old_ssid} → {ssid}"}


def restart_wifi_action():
    make_rw()
    try:
        restart_wifi_service()
    finally:
        make_ro()
    return {"message": "Wi-Fi redémarré."}




# ============================================================
# TRANSFERT D'IMAGES PAR USB
# ============================================================

USB_TRANSFER_BIN = "/usr/local/bin/pikvm-usb-transfer"
USB_TRANSFER_STATE = Path(
    "/run/pikvm-usb-transfer-state.json"
)
USB_TRANSFER_LOG = Path(
    "/run/pikvm-usb-transfer-import.log"
)


def usb_transfer_status():
    return transfer.observe()


def usb_transfer_run(action, allow_usb_reset=False):
    args = [USB_TRANSFER_BIN, action]
    if allow_usb_reset:
        args.append('--allow-usb-reset')
    proc = subprocess.Popen(args, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT, start_new_session=True)
    try:
        output, _ = proc.communicate(timeout=240)
    except subprocess.TimeoutExpired:
        # TERM lets the worker kill its current child and unwind its resources.
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            proc.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.communicate(timeout=2)
        raise RuntimeError('Commande USB expirée ; vérifier diagnose avant toute reprise') from None
    if proc.returncode:
        raise RuntimeError(output.strip()[-2000:] or f'Erreur USB : {action}')
    return usb_transfer_status()


def usb_transfer_import_start():
    status = usb_transfer_status()
    if status['busy'] or status['state'] == 'unknown' or status['drive']['image']:
        raise RuntimeError('Éjecter proprement côté PC et attendre la fin de toute opération USB')
    # The worker owns state and locks. A second request cannot truncate its state.
    # No unbounded log file: messages are journalled by the worker itself.
    process = subprocess.Popen([USB_TRANSFER_BIN, 'import'], stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True)
    return {'message': 'Import demandé ; vérifier son état', 'pid': process.pid}



# ============================================================
# IMAGE MANAGER
# ============================================================

IMAGE_MANAGER_STORAGE = Path(
    "/var/lib/kvmd/msd"
)

IMAGE_MANAGER_LUN = Path(
    "/sys/kernel/config/usb_gadget/kvmd/"
    "functions/mass_storage.usb0/lun.0/file"
)

IMAGE_MANAGER_EXTENSIONS = {
    ".iso",
    ".img",
    ".raw",
}


def image_manager_check_name(name):

    name = str(name).strip()

    if not name:
        raise ValueError(
            "Nom d'image vide."
        )

    if len(name) > 240:
        raise ValueError(
            "Nom d'image trop long."
        )

    if (
        "/" in name
        or "\\" in name
        or "\x00" in name
        or name.startswith(".")
    ):
        raise ValueError(
            "Nom d'image invalide."
        )

    suffix = Path(name).suffix.lower()

    if suffix not in IMAGE_MANAGER_EXTENSIONS:
        raise ValueError(
            "Extension autorisée : ISO, IMG ou RAW."
        )

    return name


def image_manager_rename(data):
    old = image_manager_check_name(data.get('old_name', ''))
    new = image_manager_check_name(data.get('new_name', ''))
    return image_folders_run('rename_file', {'source': old, 'name': new})


def image_folders_run(action, payload):
    result = subprocess.run(
        ["/usr/local/bin/pikvm-image-folders", action],
        input=json.dumps(payload),
        capture_output=True,
        text=True,
        timeout=50,
    )
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or result.stdout.strip()
            or "Erreur du gestionnaire de dossiers"
        )
    return json.loads(result.stdout)


def get_battery_status():
    def read_word(reg):
        hi = int(subprocess.check_output(
            ["i2cget", "-y", "1", "0x36", hex(reg), "b"],
            text=True,
            stderr=subprocess.DEVNULL, timeout=2
        ).strip(), 16)

        lo = int(subprocess.check_output(
            ["i2cget", "-y", "1", "0x36", hex(reg + 1), "b"],
            text=True,
            stderr=subprocess.DEVNULL, timeout=2
        ).strip(), 16)

        return (hi << 8) | lo

    vcell = read_word(0x02)
    crate = read_word(0x16)

    voltage = vcell * 78.125 / 1_000_000

    percent = (voltage - 3.10) / (4.13 - 3.10) * 100.0
    percent = max(0, min(100, percent))

    if crate & 0x8000:
        crate -= 65536

    charge_rate = crate * 0.208
    charging = charge_rate > 0.5

    if charging:
        state = "charging"
    elif percent >= 100:
        state = "full"
    else:
        state = "battery"

    return {
        "percent": round(percent, 1),
        "voltage": round(voltage, 3),
        "charge_rate": round(charge_rate, 2),
        "charging": charging,
        "state": state
    }

AUTH = None
AUTH_LOCK = threading.Lock()
MUTATION_LOCK = threading.Lock()


def authorize(headers, mutation=False):
    global AUTH
    if AUTH is None:
        with AUTH_LOCK:
            if AUTH is None:
                path = Path('/usr/local/bin/pikvm-share-api')
                if not path.is_file():
                    path = Path(__file__).with_name('pikvm-share-api')
                loader = importlib.machinery.SourceFileLoader('wifi_share_auth', str(path))
                spec = importlib.util.spec_from_loader(loader.name, loader)
                module = importlib.util.module_from_spec(spec)
                loader.exec_module(module)
                AUTH = module
    AUTH.authenticate(headers)
    if mutation:
        AUTH.check_csrf(headers)


class Handler(BaseHTTPRequestHandler):
    server_version = 'PiKVM-Portable-Wifi'
    def setup(self):
        super().setup()
        self.connection.settimeout(15)

    def log_message(self, fmt, *args):
        return

    def send_json(self, code, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def read_body(self):
        length = int(self.headers.get("Content-Length", "0") or "0")
        if self.headers.get('Transfer-Encoding') or length < 0 or length > 65536:
            raise ValueError('Corps de requête interdit ou trop volumineux')
        if length <= 0:
            return {}
        raw = self.rfile.read(length).decode("utf-8")
        data = json.loads(raw or '{}')
        if not isinstance(data, dict):
            raise ValueError('Objet JSON attendu')
        return data

    def do_GET(self):
        path = urlparse(self.path).path

        try:
            authorize(self.headers)
            if path == "/api/image-manager/folders":
                self.send_json(200, {
                    "ok": True,
                    "result": image_folders_run("list", {})
                })

            elif path == "/api/usb-transfer/status":
                self.send_json(200, {
                    "ok": True,
                    "transfer": usb_transfer_status()
                })

            elif path == "/api/battery":
                try:
                    self.send_json(200, {
                        "ok": True,
                        "battery": get_battery_status()
                    })
                except Exception as e:
                    self.send_json(500, {
                        "ok": False,
                        "error": str(e)
                    })

            elif path == "/api/status":
                self.send_json(200, {"ok": True, "status": wifi_status()})
            elif path == "/api/networks":
                self.send_json(200, {"ok": True, "networks": get_networks()})
            elif path == "/api/scan":
                self.send_json(200, {"ok": True, "scan": scan_wifi()})
            else:
                self.send_json(404, {"ok": False, "error": "Endpoint introuvable."})
        except Exception as e:
            self.send_json(getattr(e, "status", 500), {"ok": False, "error": str(e)})

    def do_POST(self):
        path = urlparse(self.path).path
        locked = False
        try:
            authorize(self.headers, mutation=True)
            data = self.read_body()
            locked = MUTATION_LOCK.acquire(blocking=False)
            if not locked:
                self.send_json(423, {'ok': False, 'error': 'Opération de gestion déjà en cours'})
                return

            if path == "/api/image-manager/folders/action":
                action = data.get("action", "")
                allowed = {"mkdir", "rmdir", "rename_dir", "move_file", "rename_file"}
                if action not in allowed:
                    raise ValueError("Action de dossier non autorisée")
                self.send_json(200, {
                    "ok": True,
                    "result": image_folders_run(action, data)
                })

            elif path == "/api/usb-transfer/start":
                self.send_json(200, {
                    "ok": True,
                    "transfer": usb_transfer_run("start", data.get("allow_usb_reset") is True)
                })

            elif path == "/api/usb-transfer/stop":
                self.send_json(200, {
                    "ok": True,
                    "transfer": usb_transfer_run("stop")
                })

            elif path == "/api/usb-transfer/prepare":
                self.send_json(200, {
                    "ok": True,
                    "transfer": usb_transfer_run("prepare")
                })

            elif path == "/api/usb-transfer/import":
                self.send_json(200, {
                    "ok": True,
                    **usb_transfer_import_start()
                })

            elif path == "/api/usb-transfer/reset":
                self.send_json(200, {
                    "ok": True,
                    "transfer": usb_transfer_run("reset")
                })

            elif path == "/api/image-manager/rename":
                self.send_json(200, {
                    "ok": True,
                    **image_manager_rename(data)
                })

            elif path == "/api/add":
                self.send_json(200, {"ok": True, **add_wifi(data)})
            elif path == "/api/update":
                self.send_json(200, {"ok": True, **update_wifi(data)})
            elif path == "/api/delete":
                self.send_json(200, {"ok": True, **delete_wifi(data)})
            elif path == "/api/force":
                self.send_json(200, {"ok": True, **force_wifi(data)})
            elif path == "/api/pikvm-restart":
                transfer.require_idle_for_power()
                self.send_json(200, {"ok": True, "message": "Restarting PiKVM"})
                subprocess.Popen([
                    "/bin/sh", "-c",
                    "sleep 1; systemctl restart kvmd.service kvmd-nginx.service"
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

            elif path == "/api/pikvm-poweroff":
                transfer.reserve_poweroff()
                subprocess.Popen([
                    "/bin/sh", "-c",
                    "sleep 1; systemctl poweroff"
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                self.send_json(200, {"ok": True, "message": "Powering off PiKVM"})

            elif path == "/api/restart":
                self.send_json(200, {"ok": True, **restart_wifi_action()})
            else:
                self.send_json(404, {"ok": False, "error": "Endpoint introuvable."})
        except Exception as e:
            self.send_json(getattr(e, "status", 500), {"ok": False, "error": str(e)})
        finally:
            if locked:
                MUTATION_LOCK.release()


class ReuseTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads = True
    slots = threading.BoundedSemaphore(8)

    def process_request(self, request, client_address):
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except BaseException:
            self.slots.release()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.slots.release()


def main():
    with ReuseTCPServer((HOST, PORT), Handler) as httpd:
        httpd.serve_forever()


if __name__ == "__main__":
    main()
