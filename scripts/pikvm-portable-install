#!/usr/bin/env python3
"""Additive Portable OS install/restore. Never configures GPIO, gadget or Drive 0."""
import argparse
import contextlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

REPO = Path(__file__).resolve().parent.parent
PORTABLE_SERVICE = 'pikvm-portable-api.service'
SHARE_API = Path('/usr/local/bin/pikvm-share-api')
SHARE_EXTRAS = Path('/usr/share/kvmd/extras/portable-os')
LIB = Path('/usr/local/lib/pikvm-portable')
WEB_ROOT = Path('/usr/share/kvmd/web')
OLED_UNITS = ('pikvm-oled-custom.service', 'pikvm-button-menu.service')
BIN = Path('/usr/local/bin')
PREFLIGHT_JOURNAL = None


def preflight_journal():
    global PREFLIGHT_JOURNAL
    if PREFLIGHT_JOURNAL is None:
        path = REPO / 'scripts/pikvm_preflight.py'
        if not path.is_file():
            path = LIB / 'pikvm_preflight.py'
        PREFLIGHT_JOURNAL = load('portable_preflight', path).Journal()
    return PREFLIGHT_JOURNAL


def oled_preflight():
    import hashlib
    # Do not overwrite unidentified on-device Python/system compatibility fixes.
    baseline = json.loads((REPO / 'scripts/pikvm-oled-baselines.json').read_text(encoding='utf-8'))
    paths = [(name, BIN / name) for name in ('pikvm-oled-custom', 'pikvm-button-menu')]
    shared = LIB / 'pikvm_oled.py'
    if shared.exists() or shared.is_symlink():
        paths.append(('pikvm_oled.py', shared))
    for name in ('pikvm_oled_ui.py','pikvm_oled_nav.py','pikvm_oled_control.py','pikvm_gestures.py','pikvm_iso.py'):
        target=LIB/name
        if target.exists() or target.is_symlink():paths.append((name,target))
    for name, installed in paths:
        if installed.is_symlink() or not installed.is_file():
            raise RuntimeError('Script OLED installé absent ou non ordinaire : ' + name)
        source = installed.read_bytes().replace(b'\r\n', b'\n')
        candidate = (REPO / 'scripts' / name).read_bytes().replace(b'\r\n', b'\n')
        known = baseline.get(name,[])
        known = known if isinstance(known,list) else [known]
        if source != candidate and hashlib.sha256(source).hexdigest() not in known:
            raise RuntimeError('Correctifs OLED locaux à examiner avant migration : ' + name)
    gpio = LIB / 'pikvm_gpio.py'
    if gpio.exists() or gpio.is_symlink():
        if (gpio.is_symlink() or not gpio.is_file() or
                (gpio.read_bytes().replace(b'\r\n',b'\n') != (REPO / 'scripts/pikvm_gpio.py').read_bytes().replace(b'\r\n',b'\n') and
                 hashlib.sha256(gpio.read_bytes().replace(b'\r\n',b'\n')).hexdigest() not in baseline.get('pikvm_gpio.py',[]))):
            raise RuntimeError('Correctifs GPIO locaux à examiner avant migration : pikvm_gpio.py')
    journal = preflight_journal()
    journal.step('power-hold-active', ['systemctl', 'is-active', '--quiet', 'pikvm-power-hold.service'], 10)
    # Pillow was checked in an isolated process by compatibility(), before the
    # parent loads storage/auth/HTML modules. Do not repeat that heavy startup.


def oled_states(h):
    return {unit: {'active': active(h, unit), 'enabled': subprocess.run(
        ['systemctl', 'is-enabled', '--quiet', unit], stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL).returncode == 0} for unit in OLED_UNITS}


def stop_oled(h):
    # Stop the menu first: no timer may write another frame during the update.
    h.run(['systemctl', 'stop', 'pikvm-button-menu.service'])
    h.run(['systemctl', 'stop', 'pikvm-oled-custom.service'])


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def helper():
    path = REPO / 'scripts/pikvm-share-install'
    if not path.exists():
        path = LIB / 'installer.py'
    if not path.is_file():
        raise RuntimeError('Helper autonome absent : lancer depuis le dépôt complet.')
    module = load('portable_installer_helpers', path)
    module.SERVICE = PORTABLE_SERVICE
    module.SHARE_UNIT = Path('/etc/systemd/system') / PORTABLE_SERVICE
    module.SHARE_ENABLE_LINK = Path('/etc/systemd/system/multi-user.target.wants') / PORTABLE_SERVICE
    module.BACKUPS = Path('/root/pikvm-portable-os-backups')
    return module


def manual_shutdown_policy(source):
    """Remove only the known auto-shutdown start expression, preserving local fixes.

    No AST unparse: leave all unrelated text, imports and Python 3.14 fixes intact.
    Unknown ways of starting the service are rejected, never rewritten blindly.
    """
    import ast
    tree = ast.parse(source)
    lines = source.splitlines(keepends=True)
    changes = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.Expr) or not isinstance(node.value, ast.Call):
            continue
        call = node.value
        if not call.args or not isinstance(call.args[0], (ast.List, ast.Tuple)):
            continue
        args = call.args[0].elts
        if len(args) < 3 or not all(isinstance(arg, ast.Constant) for arg in args[:2]):
            continue
        if [arg.value for arg in args[:2]] != ['systemctl', 'start']:
            continue
        target = args[2]
        if ((isinstance(target, ast.Name) and target.id == 'AUTO_SERVICE') or
                (isinstance(target, ast.Constant) and target.value == 'pikvm-auto-shutdown.service')):
            if len(args) != 3:
                raise RuntimeError('Commande de redémarrage inattendue ; patch manuel requis.')
            changes.append((node.lineno - 1, node.end_lineno))
    for start, end in sorted(changes, reverse=True):
        indent = lines[start][:len(lines[start]) - len(lines[start].lstrip())]
        lines[start:end] = [indent + 'pass  # Portable OS: inactivity shutdown is manual-only.\n']
    result = ''.join(lines)
    for node in ast.walk(ast.parse(result)):
        if isinstance(node, ast.Call):
            fragment = ast.get_source_segment(result, node) or ''
            if (re.search(r'systemctl.*\bstart\b', fragment, re.DOTALL) and
                    ('AUTO_SERVICE' in fragment or 'pikvm-auto-shutdown.service' in fragment)):
                raise RuntimeError('Redémarrage automatique non reconnu ; patch manuel requis.')
    compile(result, 'pikvm-share-api', 'exec')
    return result


def policy_preflight():
    if SHARE_API.is_symlink() or not SHARE_API.is_file():
        raise RuntimeError('Installer/configurer SHARE avant Portable OS ; API ordinaire requise.')
    source = SHARE_API.read_text(encoding='utf-8')
    patched = security_share_policy(share_power_policy(bounded_share_policy(manual_shutdown_policy(source))))
    auth = load('portable_installed_share', SHARE_API)
    if auth.kvmd_check() not in (401, 403):
        raise RuntimeError('Une authentification PiKVM active est obligatoire.')
    if patched != source:
        backend = auth.LinuxBackend()
        backend.validate_image()
        if backend.drive() or backend.lease_read():
            raise RuntimeError('Éjecter puis démonter/libérer SHARE avant le patch de politique.')
        backend.ensure_unmounted()
    return patched.encode(), patched != source


def share_patch_audit():
    """Reproduce transformations on UTF-8 text in memory; never write SHARE."""
    import ast
    import difflib
    import hashlib
    original=SHARE_API.read_text(encoding='utf-8');result=original
    transforms=(manual_shutdown_policy,bounded_share_policy,share_power_policy,security_share_policy)
    for transform in transforms:
        updated=transform(result)
        print('SHARE_COMPONENT='+json.dumps({'name':transform.__name__,'changed':updated!=result}),flush=True)
        result=updated
    compile(result,str(SHARE_API),'exec')
    again=result
    for transform in transforms:again=transform(again)
    if again!=result:raise RuntimeError('Patch SHARE non idempotent')
    def storage(text):
        return ast.dump(next(node for node in ast.parse(text).body if isinstance(node,ast.ClassDef) and node.name=='LinuxBackend'))
    if storage(original)!=storage(result):raise RuntimeError('Operations stockage SHARE modifiees')
    auth=load('portable_share_audit',SHARE_API)
    if auth.kvmd_check() not in (401,403):raise RuntimeError('Authentification native non active')
    print('SHARE_RESULT='+json.dumps({'path':str(SHARE_API),'source_sha256':hashlib.sha256(SHARE_API.read_bytes()).hexdigest(),'patched_utf8_sha256':hashlib.sha256(result.encode('utf-8')).hexdigest(),'syntax':True,'idempotent':True,'storage_unchanged':True,'native_auth':True}),flush=True)
    print('\n'.join(difflib.unified_diff(original.splitlines(),result.splitlines(),fromfile='installed',tofile='RC13',lineterm='')),flush=True)


def security_share_policy(source):
    # Surgical additions only. Preserve the existing storage and Python fixes.
    auth='def authenticate(headers, checker=kvmd_check):\n'
    guarded=auth+"    if headers.get('X-Portable-Delegation'):\n        from pikvm_security_bridge import verify\n        return verify(headers).owner\n"
    start='        self.response_started = False\n        try:\n'
    bound=start+"            if self.headers.get('X-Portable-Delegation'):\n                from pikvm_security_bridge import bind\n                bind(self.headers,self.command,self.path)\n"
    if guarded in source and bound in source:return source
    if 'X-Portable-Delegation' in source or source.count(auth)!=1 or source.count(start)!=1 or source.count('import uuid\n')!=1:
        raise RuntimeError('Adaptateur auth SHARE local inconnu ; examen requis avant migration')
    source=source.replace(auth,guarded,1).replace(start,bound,1)
    source=source.replace('import uuid\n',"import uuid\nimport sys\nsys.path.insert(0, '/usr/local/lib/pikvm-portable')\n",1)
    compile(source,'pikvm-share-api','exec')
    return source


def bounded_share_policy(source):
    """Replace only the recognized HTTP server class, preserving local fixes."""
    import ast
    legacy = '''class Server(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads = False
    block_on_close = True
    request_queue_size = 8'''
    candidate = (REPO / 'scripts/pikvm-share-api').read_text(encoding='utf-8')
    def server(text):
        nodes = [n for n in ast.parse(text).body if isinstance(n, ast.ClassDef) and n.name == 'Server']
        if len(nodes) != 1:
            raise RuntimeError('Classe serveur SHARE inconnue ; examen manuel requis')
        return nodes[0], ast.get_source_segment(text, nodes[0])
    node, installed = server(source)
    _, replacement = server(candidate)
    if ast.dump(ast.parse(installed)) == ast.dump(ast.parse(replacement)):
        return source
    if ast.dump(ast.parse(installed)) != ast.dump(ast.parse(legacy)):
        raise RuntimeError('Correctifs locaux du serveur SHARE inconnus ; aucun remplacement')
    lines = source.splitlines(keepends=True)
    lines[node.lineno-1:node.end_lineno] = [replacement + '\n']
    result = ''.join(lines)
    compile(result, 'pikvm-share-api', 'exec')
    return result


def share_power_policy(source):
    old = '    def operation(self):\n        if not self.lock.acquire(blocking=False):'
    new = ("    def operation(self):\n        if Path('/run/pikvm-poweroff-requested').exists():\n"
           "            raise ShareError('Arrêt demandé ; accès stockage suspendu.', 423)\n"
           '        if not self.lock.acquire(blocking=False):')
    if new in source:
        return source
    if source.count(old) != 1:
        raise RuntimeError('Garde opération SHARE inconnue ; correctif local à examiner')
    result = source.replace(old, new, 1)
    compile(result, 'pikvm-share-api', 'exec')
    return result


def file_map():
    result = {}
    for name in ('DejaVuSans.ttf','LICENSE-DejaVu.txt'):
        result[LIB/'fonts'/name]=((REPO/'assets/fonts'/name).read_bytes(),0o644)
    for relative, destination in (('web/legacy', '/usr/share/kvmd/web/legacy'),
                                  ('web/extras/portable-os', '/usr/share/kvmd/web/extras/portable-os'),
                                  ('kvmd-extras/portable-os', '/usr/share/kvmd/extras/portable-os')):
        for source in (REPO / relative).rglob('*'):
            parts = source.relative_to(REPO / relative).parts
            if (source.is_file() and not source.is_symlink() and
                    source.suffix in {'.js', '.css', '.svg', '.html', '.json', '.conf', '.yaml'} and
                    not any(part.startswith('.') or part == 'node_modules' for part in parts)):
                result[Path(destination) / source.relative_to(REPO / relative)] = (source.read_bytes(), 0o644)
    for name in ('pikvm-portable-api', 'pikvm-portable-install', 'pikvm-portable-perf', 'pikvm-oled-custom', 'pikvm-button-menu'):
        result[Path('/usr/local/bin') / name] = ((REPO / 'scripts' / name).read_bytes(), 0o755)
    result[Path('/etc/systemd/system') / PORTABLE_SERVICE] = ((REPO / 'systemd' / PORTABLE_SERVICE).read_bytes(), 0o644)
    result[LIB / 'installer.py'] = ((REPO / 'scripts/pikvm-share-install').read_bytes(), 0o644)
    result[LIB / 'preflight.sh'] = ((REPO / 'scripts/pikvm-portable-preflight.sh').read_bytes(), 0o755)
    result[LIB / 'pikvm-python-integrity.sh'] = ((REPO / 'scripts/pikvm-python-integrity.sh').read_bytes(), 0o755)
    result[LIB / 'pikvm_preflight.py'] = ((REPO / 'scripts/pikvm_preflight.py').read_bytes(), 0o644)
    result[LIB / 'pikvm_preflight_probe.py'] = ((REPO / 'scripts/pikvm_preflight_probe.py').read_bytes(), 0o644)
    result[LIB / 'pikvm-portable-drive-check.sh'] = ((REPO / 'scripts/pikvm-portable-drive-check.sh').read_bytes(), 0o755)
    result[LIB / 'pikvm_oled.py'] = ((REPO / 'scripts/pikvm_oled.py').read_bytes(), 0o644)
    result[LIB / 'pikvm_gpio.py'] = ((REPO / 'scripts/pikvm_gpio.py').read_bytes(), 0o644)
    result[LIB / 'pikvm_transfer.py'] = ((REPO / 'scripts/pikvm_transfer.py').read_bytes(), 0o644)
    for name in ('pikvm_config.py','pikvm_settings.py','pikvm_activity.py','pikvm_oled_ui.py','pikvm_oled_nav.py','pikvm_oled_control.py','pikvm_gestures.py','pikvm_iso.py'):
        result[LIB / name] = ((REPO / 'scripts' / name).read_bytes(), 0o644)
    for name in ('pikvm_security.py','pikvm_security_bridge.py','pikvm_security_admin.py','pikvm_security_gateway.py','pikvm_security_migration.py','pikvm_access.py','pikvm_ssh.py','pikvm-maintenance-command','pikvm-security-authorized-keys','pikvm-security-ssh'):
        result[LIB/name]=((REPO/'scripts'/name).read_bytes(),0o755 if name.startswith('pikvm-') else 0o644)
    result[Path('/etc/systemd/system/pikvm-security-gateway.service')]=((REPO/'systemd/pikvm-security-gateway.service').read_bytes(),0o644)
    release=json.loads((REPO/'web/extras/portable-os/package.json').read_text())['version']
    result[LIB/'release.json']=(json.dumps({'version':release,'installed_at':time.time()}).encode(),0o600)
    for source, destination in storage_sources()['files'].items():
        result[Path(destination)] = ((REPO / source).read_bytes(), 0o755 if source.startswith('scripts/') else 0o644)
    result[Path('/usr/local/bin/pikvm-portable-report')] = ((REPO / 'scripts/pikvm-portable-report').read_bytes(), 0o755)
    result[LIB / 'pikvm-storage-baselines.json'] = ((REPO / 'scripts/pikvm-storage-baselines.json').read_bytes(), 0o644)
    import hashlib
    result[LIB/'integrity.json']=(json.dumps({str(p):hashlib.sha256(content).hexdigest() for p,(content,_) in result.items()},sort_keys=True).encode(),0o600)
    return result


def storage_sources():
    return json.loads((REPO / 'scripts/pikvm-storage-baselines.json').read_text(encoding='utf-8'))


def storage_preflight():
    import hashlib
    evidence = storage_sources()
    for source, destination in evidence['files'].items():
        installed = Path(destination)
        if installed.is_symlink() or not installed.is_file():
            raise RuntimeError('Composant historique absent/non ordinaire : ' + destination)
        content = installed.read_bytes().replace(b'\r\n', b'\n')
        if (content != (REPO / source).read_bytes().replace(b'\r\n', b'\n') and
                hashlib.sha256(content).hexdigest() not in (evidence['baselines'][destination] if isinstance(evidence['baselines'][destination],list) else [evidence['baselines'][destination]])):
            raise RuntimeError('Correctif local inconnu à examiner, aucun remplacement : ' + destination)
    transfer = load('portable_transfer_preflight', REPO / 'scripts/pikvm_transfer.py')
    observed = transfer.observe()
    if observed['busy'] or not observed['drive']['known'] or observed['drive']['image']:
        raise RuntimeError('Maintenance exige Drive 0 éjecté et aucun import actif ; état matériel connu')


def preflight():
    journal = preflight_journal()
    # Shared implementation; no opaque outer process or cumulative 60s timeout.
    journal.compatibility()
    with journal.phase('storage-migration'):
        storage_preflight()
    with journal.phase('native-navigation'):
        navigation_preflight()
    with journal.phase('oled-baselines-and-health'):
        oled_preflight()


def navigation_preflight():
    """Read-only native DOM contract: never patch KVMD's own frontend."""
    from html.parser import HTMLParser
    class NativeDocument(HTMLParser):
        ids = None
        full_tab = False

        def handle_starttag(self, tag, attrs):
            values = dict(attrs)
            if values.get('id'):
                self.ids.add(values['id'])
            if tag == 'button' and 'data-wm-window-set-full-tab' in values:
                self.full_tab = True
    native = WEB_ROOT / 'kvm/index.html'
    if native.is_symlink() or not native.is_file():
        raise RuntimeError('Document KVM natif ordinaire absent ; installation interrompue.')
    parser = NativeDocument()
    parser.ids = set()
    parser.feed(native.read_text(encoding='utf-8'))
    required = {'navbar', 'stream-window', 'hid-mute-switch', 'msd-dropdown', 'atx-dropdown',
                'shortcuts-dropdown', 'macro-dropdown', 'text-dropdown', 'system-dropdown'}
    if required - parser.ids or not parser.full_tab:
        raise RuntimeError('Contrat KVM 4.213 incompatible ; aucun fichier natif modifié.')


def preferences_module():
    return load('portable_preferences',REPO/'scripts/pikvm_config.py')


def snapshot_preferences(h,backup):
    config=preferences_module();target=config.pst_path()
    if target.is_symlink() or target.parent.is_symlink():raise RuntimeError('Chemin des préférences interdit')
    metadata={'target':str(target),'exists':target.exists()}
    if metadata['exists']:
        if not target.is_file() or target.stat().st_size>config.MAX_BYTES or not config.Store(target).read()['healthy']:
            raise RuntimeError('Préférences invalides ; aucune migration ni interruption')
        h.write_file(backup/'preferences.json',target.read_bytes(),0o600)
        metadata['sha256']=h.digest(backup/'preferences.json')
    return metadata


def restore_preferences(h,backup,manifest):
    metadata=manifest.get('portable_preferences')
    if metadata is None:return  # Older snapshots predate preference migration.
    config=preferences_module();target=config.pst_path()
    if target.is_symlink() or target.parent.is_symlink():raise RuntimeError('Chemin des préférences interdit')
    raw=(backup/'preferences.json').read_bytes() if metadata['exists'] else None
    # Idempotent: do not acquire a lease for an unchanged document.
    if (target.read_bytes() if target.exists() else None)==raw:return
    if target.exists():
        h.write_file(backup/'preferences-before-restore.json',target.read_bytes(),0o600)
    def write(actual):
        if actual!=target:raise RuntimeError('Cible PST modifiée')
        if raw is None:actual.unlink(missing_ok=True)
        else:h.write_file(actual,raw,0o600)
    config.pst_commit(write)


def verify_backup(h, backup):
    manifest = json.loads((backup / 'manifest.json').read_text())
    for entry in manifest['files']:
        if entry['exists']:
            source = backup / entry['file']
            if source.is_symlink() or not source.resolve().is_relative_to(backup.resolve()):
                raise RuntimeError('Chemin de sauvegarde interdit.')
            if h.digest(source) != entry['sha256']:
                raise RuntimeError('Sauvegarde altérée ; aucun service arrêté.')
    metadata=manifest.get('portable_preferences')
    if metadata is not None:
        if not isinstance(metadata,dict) or metadata.get('target')!=str(preferences_module().pst_path()) or type(metadata.get('exists')) is not bool:
            raise RuntimeError('Métadonnées PST invalides ; aucun service arrêté')
        source=backup/'preferences.json'
        if metadata['exists'] and (source.is_symlink() or not source.is_file() or source.stat().st_size>16384 or h.digest(source)!=metadata.get('sha256')):
            raise RuntimeError('Sauvegarde des préférences altérée ; aucun service arrêté')
    if 'portable_security' in manifest:
        from pikvm_security_migration import verify
        verify(h,backup,manifest['portable_security'])
    return manifest


def wait_ready(h, timeout=20):
    import http.client
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        connection = http.client.HTTPConnection('127.0.0.1', 9878, timeout=1)
        try:
            connection.request('GET', '/extras/portable-os/api/status')
            response = connection.getresponse()
            payload = json.loads(response.read(4096))
            if (response.status == 401 and payload.get('ok') is False and
                    response.getheader('Server', '').startswith('PiKVM-Portable-OS') and h.service_state()['active']):
                return
        except (OSError, ValueError, http.client.HTTPException):
            pass
        finally:
            connection.close()
        time.sleep(0.25)
    raise RuntimeError('API Portable OS non prête ou authentification absente ; rollback requis.')


def wait_oled_ready(h, observed_after, timeout=25):
    module = load('portable_oled_readiness', LIB / 'pikvm_oled.py')
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            # A pre-update frame or a leftover socket never proves readiness.
            if (module.read_frame()['monotonic'] >= observed_after and
                    module.ping().get('ready') is True and active(h, 'pikvm-button-menu.service')):
                return
        except (OSError, module.OledError):
            pass
        time.sleep(.25)
    raise RuntimeError('Miroir OLED ou gestionnaire logique non prêt ; rollback requis.')


def wait_wifi_ready(timeout=15):
    import http.client
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        connection = http.client.HTTPConnection('127.0.0.1', 9876, timeout=1)
        try:
            connection.request('GET', '/api/usb-transfer/status')
            response = connection.getresponse()
            payload = json.loads(response.read(4096))
            if (response.status == 401 and payload.get('ok') is False and
                    response.getheader('Server', '').startswith('PiKVM-Portable-Wifi')):
                return
        except (OSError, ValueError, http.client.HTTPException):
            pass
        finally:
            connection.close()
        time.sleep(.25)
    raise RuntimeError('API Wi-Fi/stockage non prête ou authentification absente ; rollback requis.')


@contextlib.contextmanager
def mutation_lock():
    import fcntl
    fd = os.open('/run/pikvm-portable-install.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'r+') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield


def nginx_config(h):
    candidate = h.NGINX_CONFIG.with_name('portable-os-nginx.candidate')
    try:
        h.run(['kvmd-nginx-mkconf', str(h.NGINX_PREFIX / 'nginx.conf.mako'), str(candidate)])
        dump = h.run(h.nginx_args('-T', candidate))
        files = h.nginx_dump_files(dump)
        for extra, upstream in (('wifi-wizard', 'wifi_wizard_api'), ('image-manager', 'image_manager_api')):
            directory = SHARE_EXTRAS.parent / extra
            path = directory / 'nginx.ctx-server.conf'
            if files.get(path.resolve()) != path.read_text().strip():
                raise RuntimeError('Configuration historique non incluse par nginx : ' + extra)
            body = h.nginx_location(files[path.resolve()], '^~', '/extras/' + extra + '/api/')
            h.require_nginx_directive(body, r'\bauth_request\s+/auth_check\s*;', 'authentification stockage')
            h.require_nginx_directive(body, r'\bproxy_set_header\s+X-Share-Origin\s+\$scheme://\$http_host\s*;', 'origine stockage')
            h.require_nginx_directive(body, r'\bproxy_pass\s+http://' + upstream + r'\s*;', 'proxy stockage')
            h.require_nginx_directive(body, r'\bproxy_intercept_errors\s+off\s*;', 'erreurs JSON stockage')
            http = directory / 'nginx.ctx-http.conf'
            if files.get(http.resolve()) != http.read_text().strip():
                raise RuntimeError('Upstream historique non inclus : ' + extra)
            h.require_nginx_directive(files[http.resolve()], r'\bserver\s+127\.0\.0\.1:9876\s+[^;]*;', 'API stockage locale 9876')
        for name in ('nginx.ctx-http.conf', 'nginx.ctx-server.conf'):
            path = SHARE_EXTRAS / name
            if files.get(path.resolve()) != path.read_text().strip():
                raise RuntimeError('Include Portable OS absent ou modifié : ' + name)
        server = files[(SHARE_EXTRAS / 'nginx.ctx-server.conf').resolve()]
        api = h.nginx_location(server, '^~', '/extras/portable-os/api/')
        web = h.nginx_location(server, '^~', '/extras/portable-os/')
        for body in (api, web):
            h.require_nginx_directive(body, r'\bauth_request\s+/auth_check\s*;', 'authentification Portable OS')
        entry = h.nginx_location(server, '=', '/')
        h.require_nginx_directive(entry, r'\breturn\s+302\s+/extras/portable-os/\s*;', 'entrée sans boucle')
        legacy = h.nginx_location(server, '^~', '/legacy/')
        h.require_nginx_directive(legacy, r'\bauth_request\s+/auth_check\s*;', 'authentification secours')
        h.require_nginx_directive(legacy, r'\broot\s+/usr/share/kvmd/web\s*;', 'secours autonome')
        if re.search(r'location\s+(?:=|\^~)?\s*/(?:kvm|api|share)/?\s*\{', server):
            raise RuntimeError('Une route native est remplacée par Portable OS.')
        for name in ('index.html', 'main.js', 'routes.js', 'style.css'):
            if not (WEB_ROOT / 'legacy' / name).is_file():
                raise RuntimeError('Secours incomplet : ' + name)
        h.require_nginx_directive(api, r'\bproxy_pass\s+http://pikvm_portable_api\s*;', 'URI API conservée')
        h.require_nginx_directive(api, r'\bproxy_set_header\s+X-Share-Origin\s+\$scheme://\$http_host\s*;', 'origine CSRF')
        h.write_file(h.NGINX_CONFIG, candidate.read_bytes())
        h.reload_nginx()
    finally:
        candidate.unlink(missing_ok=True)


def active(h, service):
    return subprocess.run(['systemctl', 'is-active', '--quiet', service],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def create_backup(h):
    oled_preflight()
    policy, changed = policy_preflight()
    mapping = file_map()
    if changed:
        mapping[SHARE_API] = (policy, SHARE_API.stat().st_mode & 0o777)
    probe = h.BACKUPS
    while not probe.exists():
        probe = probe.parent
    required = 16 * 1024**2 + sum(len(content) for content, _ in mapping.values())
    required += sum(path.stat().st_size for path in mapping if path.is_file())
    if shutil.disk_usage(probe).free < required:
        raise RuntimeError('Espace insuffisant pour mise à jour et sauvegarde ; aucun service arrêté.')
    backup = h.snapshot([*mapping, h.NGINX_CONFIG])
    manifest_path = backup / 'manifest.json'
    manifest = json.loads(manifest_path.read_text())
    manifest['share_policy_patch'] = changed
    manifest['share_was_active'] = active(h, 'pikvm-share-api.service')
    manifest['oled_units'] = oled_states(h)
    manifest['wifi_was_active'] = active(h, 'wifi-wizard-api.service')
    manifest['portable_preferences']=snapshot_preferences(h,backup)
    from pikvm_security_migration import snapshot
    manifest['portable_security']=snapshot(h,backup)
    h.write_file(manifest_path, json.dumps(manifest, indent=2).encode(), 0o600)
    verify_backup(h, backup)  # Verify every saved byte before stopping any service.
    print('Sauvegarde : ' + str(backup), flush=True)
    return backup, mapping, changed, manifest


def install(h):
    backup, mapping, changed, manifest = create_backup(h)
    try:
        stop_oled(h)
        if manifest['wifi_was_active']:
            h.run(['systemctl', 'stop', 'wifi-wizard-api.service'])
        if h.service_state()['active']:
            h.run(['systemctl', 'stop', PORTABLE_SERVICE])
        if changed:
            h.run(['systemctl', 'stop', 'pikvm-share-api.service'])
        for destination, (content, mode) in mapping.items():
            h.write_file(destination, content, mode)
        h.run(['systemctl', 'daemon-reload'])
        if changed and manifest['share_was_active']:
            h.run(['systemctl', 'start', 'pikvm-share-api.service'])
        if manifest['wifi_was_active']:
            h.run(['systemctl', 'start', 'wifi-wizard-api.service'])
            wait_wifi_ready()
        # Persist the mirror across boots; snapshot restores original enablement.
        # Do not let systemd start/restart the power-hold dependency indirectly.
        oled_started = time.monotonic()
        for unit in OLED_UNITS:
            h.run(['systemctl', 'enable', unit])
            h.run(['systemctl', '--job-mode=ignore-dependencies', 'start', unit])
        wait_oled_ready(h, oled_started)
        # Stage service/readiness before switching any public nginx routing.
        h.run(['systemctl', 'start', PORTABLE_SERVICE])
        wait_ready(h)
        nginx_config(h)
        h.run(['systemctl', 'enable', PORTABLE_SERVICE])
    except Exception:
        restore(h, backup)
        raise
    print('Portable OS prêt : /extras/portable-os/ — interfaces historiques conservées.')


def restore(h, backup):
    manifest = verify_backup(h, backup)
    # Revoke the restricted entry point before rolling back auth-aware services.
    if Path('/etc/systemd/system/pikvm-security-gateway.service').is_file():
        h.run(['systemctl','stop','pikvm-security-gateway.service'])
        h.run(['systemctl','disable','pikvm-security-gateway.service'])
    if manifest.get('share_policy_patch'):
        # A live SHARE volume must never be interrupted to restore application files.
        auth = load('portable_restore_share', SHARE_API)
        backend = auth.LinuxBackend()
        if backend.drive() or backend.lease_read():
            raise RuntimeError('Éjecter et libérer SHARE avant restauration.')
        backend.ensure_unmounted()
    if 'oled_units' in manifest:
        stop_oled(h)
    if manifest.get('wifi_was_active'):
        h.run(['systemctl', 'stop', 'wifi-wizard-api.service'])
    if manifest.get('share_policy_patch'):
        h.run(['systemctl', 'stop', 'pikvm-share-api.service'])
    if h.service_state()['active']:
        h.run(['systemctl', 'stop', PORTABLE_SERVICE])
    restore_preferences(h,backup,manifest)
    if 'portable_security' in manifest:
        from pikvm_security_migration import restore_state
        restore_state(h,backup,manifest['portable_security'])
    restart = h.restore_files(backup)
    h.reload_nginx()
    if manifest.get('wifi_was_active'):
        h.run(['systemctl', 'start', 'wifi-wizard-api.service'])
    if manifest.get('share_policy_patch') and manifest.get('share_was_active'):
        h.run(['systemctl', 'start', 'pikvm-share-api.service'])
    if restart:
        h.run(['systemctl', 'start', PORTABLE_SERVICE])
    for unit, previous in manifest.get('oled_units', {}).items():
        if unit in OLED_UNITS:
            h.run(['systemctl', 'enable' if previous['enabled'] else 'disable', unit])
            if previous['active']:
                h.run(['systemctl', '--job-mode=ignore-dependencies', 'start', unit])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('check', 'share-audit', 'backup-only', 'install', 'restore'))
    parser.add_argument('backup', nargs='?', type=Path)
    parser.add_argument('--approve-security-candidate',help='SHA256 du MANIFEST RC13 explicitement approuvé ; ne démarre ni passerelle ni SSH')
    args = parser.parse_args()
    if not hasattr(os, 'geteuid') or os.geteuid() != 0:
        raise SystemExit('root requis sur le PiKVM, après autorisation de déploiement.')
    sys.dont_write_bytecode = True
    if args.action=='share-audit':
        try:share_patch_audit()
        except Exception:
            import traceback
            traceback.print_exc(file=sys.stdout)
            raise
        return
    if args.action in ('install','backup-only'):
        import hashlib
        manifest=REPO/'MANIFEST.sha256'
        if not manifest.is_file() or args.approve_security_candidate!=hashlib.sha256(manifest.read_bytes()).hexdigest():
            raise RuntimeError('RC13 : validation explicite de cette candidate requise (--approve-security-candidate SHA256 du MANIFEST). Aucun déploiement automatique.')
        for line in manifest.read_text().splitlines():
            digest,name=line.split('  ',1);source=REPO/name
            if not re.fullmatch('[a-f0-9]{64}',digest) or source.is_symlink() or not source.resolve().is_relative_to(REPO.resolve()) or not source.is_file() or hashlib.sha256(source.read_bytes()).hexdigest()!=digest:
                raise RuntimeError('RC13 : manifeste ou fichier candidat altéré ; aucun service arrêté.')
    if args.action != 'restore':
        preflight()
    if args.action == 'check':
        with preflight_journal().phase('share-authentication-and-policy'):
            _, changed = policy_preflight()
        print('Précontrôle sans modification système (journal temporaire conservé) ; patch SHARE nécessaire : ' + str(changed))
    elif args.action in ('install','backup-only'):
        h = helper()
        transfer = load('portable_transfer_lock', REPO / 'scripts/pikvm_transfer.py' if (REPO / 'scripts/pikvm_transfer.py').exists() else LIB / 'pikvm_transfer.py')
        with mutation_lock(), transfer.exclusive(transfer.STORAGE_LOCK), transfer.exclusive(transfer.LOCK):
            if args.action=='install':install(h)
            else:
                backup, _, _, _ = create_backup(h)
                print('RC13_RC121_BACKUP=' + str(backup), flush=True)
                print('RC13_BACKUP_VERIFIED=YES', flush=True)
    elif args.backup:
        h = helper()
        transfer = load('portable_transfer_lock', REPO / 'scripts/pikvm_transfer.py' if (REPO / 'scripts/pikvm_transfer.py').exists() else LIB / 'pikvm_transfer.py')
        with mutation_lock(), transfer.exclusive(transfer.STORAGE_LOCK), transfer.exclusive(transfer.LOCK):
            restore(h, args.backup.resolve(strict=True))
    else:
        parser.error('Chemin de sauvegarde requis pour restore')


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        raise SystemExit('ERREUR : ' + str(exc))
