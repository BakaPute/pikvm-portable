#!/usr/bin/env python3

import argparse
import signal
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/local/lib/pikvm-portable")
import pikvm_transfer as transfer


IMAGE = Path("/var/lib/kvmd/msd/.USB-TRANSFER.img")
MOUNT = Path("/run/pikvm-usb-transfer")
STATE = Path("/run/pikvm-usb-transfer-state.json")
LOCK = Path("/run/pikvm-usb-transfer.lock")

UDC_FILE = Path(
    "/sys/kernel/config/usb_gadget/kvmd/UDC"
)

LUN = Path(
    "/sys/kernel/config/usb_gadget/kvmd/"
    "functions/mass_storage.usb0/lun.0"
)

SIZE = 64 * 1024**3
LABEL = "PIKVM-XFER"

SUPPORTED = (
    ".iso",
    ".img",
    ".raw",
    ".iso.xz",
    ".img.xz",
    ".raw.xz",
)


def run(args, input_text=None, check=True, capture=False, timeout=30):
    proc = subprocess.Popen(args, stdin=subprocess.PIPE if input_text else None,
        stdout=subprocess.PIPE if capture else None, stderr=subprocess.STDOUT if capture else None,
        text=True, start_new_session=True, pass_fds=tuple(sorted(transfer.LOCK_FDS)))
    try:
        out, _ = proc.communicate(input_text, timeout=timeout)
    except BaseException as exc:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        time.sleep(1)
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.communicate(timeout=2)
        if isinstance(exc, subprocess.TimeoutExpired):
            raise RuntimeError('Délai dépassé : ' + args[0] + ' ; vérifier l’état matériel') from None
        raise
    if check and proc.returncode:
        raise RuntimeError('Commande échouée : ' + args[0] + ' : ' + (out or '')[-2000:])
    return subprocess.CompletedProcess(args, proc.returncode, out)


def write_state(state, message="", **extra):
    transfer.atomic_json(STATE, dict(state=state, message=message, timestamp=time.time(), **extra))


def drive_info():
    info = transfer.observe()['drive']
    if not info['known']:
        raise RuntimeError('État matériel inconnu ; opération refusée')
    return info


def ensure_detached():
    if drive_info()['image']:
        raise RuntimeError('Éjecter proprement côté PC : Drive 0 encore attaché')
    for path in (transfer.GADGET / 'functions').glob('mass_storage.*/lun.*/file'):
        value = path.read_text().strip()
        if value and (os.path.normpath(value) == str(IMAGE) or os.path.samefile(value, IMAGE)):
            raise RuntimeError('Source de transfert attachée à un autre LUN ; accès refusé')


def ensure_idle_storage():
    for base, dirs, files in os.walk(IMAGE.parent, followlinks=False):
        dirs[:] = [d for d in dirs if not d.startswith('.') and d != 'lost+found']
        if any(n.startswith('.__') and n.endswith('.incomplete') for n in files):
            raise RuntimeError('Upload KVMD incomplet/en cours ; examiner avant remontage')


def ensure_no_local_access():
    if run(['losetup', '--list', '--noheadings', '--output', 'NAME', '--associated', str(IMAGE)], capture=True).stdout.strip():
        raise RuntimeError('Image déjà associée à un loop ; récupération requise')
    mount = str(MOUNT).replace(' ', r'\040')
    if any(line.split()[4] == mount for line in Path('/proc/self/mountinfo').read_text().splitlines()):
        raise RuntimeError('Point de montage occupé')


def remount(mode):
    run([
        "kvmd-helper-otgmsd-remount",
        mode,
    ])


def attach_image(read_only=False):
    args = [
        "losetup",
        "--find",
        "--show",
    ]

    if read_only:
        args.append(
            "--read-only"
        )

    args.append(
        str(IMAGE)
    )

    result = run(
        args,
        capture=True,
    )

    return result.stdout.strip()


def create_image():
    # Only prepare a genuinely absent image; never truncate existing data.
    with IMAGE.open('xb') as handle:
        handle.truncate(SIZE)
        handle.flush()
        os.fsync(handle.fileno())
    run(['mkfs.exfat', '-P', 'mbr', '-L', LABEL, str(IMAGE)], timeout=120)
    with IMAGE.open('rb') as handle:
        os.fsync(handle.fileno())
    transfer.fsync_dir(IMAGE.parent)
    IMAGE.chmod(0o660)


def command_prepare():
    ensure_detached()
    ensure_no_local_access()
    if IMAGE.exists():
        transfer.ordinary(IMAGE)
        write_state('ready', 'Image existante conservée, sans formatage')
        return
    ensure_idle_storage()
    remount('rw')
    try:
        create_image()
        write_state('ready', 'Disque USB créé ; source conservée après import')
    finally:
        remount('ro')


def command_start(allow_usb_reset=False):
    if drive_info()['transfer_active']:
        write_state('connected', 'PIKVM-XFER déjà attaché')
        return
    ensure_detached()
    ensure_idle_storage()
    transfer.ordinary(IMAGE)
    ensure_no_local_access()
    if not allow_usb_reset:
        raise RuntimeError('Exige --allow-usb-reset : interruption globale USB/HID annoncée')
    luns = list((transfer.GADGET / 'functions').glob('mass_storage.*/lun.*/file'))
    if LUN / 'file' not in luns:
        raise RuntimeError('Structure du gadget inconnue')
    def check_other_users():
        for path in luns:
            if path.read_text().strip():
                raise RuntimeError('Un lecteur USB est attaché ; interruption globale refusée')
        if Path('/run/pikvm-share/lease.json').exists():
            raise RuntimeError('Gestion Web SHARE active ; activation refusée')
    check_other_users()
    udc = UDC_FILE.read_text().strip()
    if not udc:
        raise RuntimeError('Contrôleur déconnecté ; reconnexion implicite refusée')
    write_state('starting', 'Reconfiguration USB explicitement autorisée')
    remount('rw')
    try:
        with transfer.exclusive(Path('/run/pikvm-share-storage.lock')):
            check_other_users()
            UDC_FILE.write_text('\n')
            try:
                run(['kvmd-otgmsd', '-i', '0', '--set-cdrom', '0', '--set-rw', '1', '--set-image', str(IMAGE)])
            finally:
                UDC_FILE.write_text(udc + '\n')
        if not drive_info()['transfer_active']:
            raise RuntimeError('Attachement non confirmé par configfs')
        write_state('connected', 'PIKVM-XFER attaché ; éjection propre exigée')
    except Exception:
        write_state('error', 'Activation incomplète ; vérifier configfs avant reprise')
        # Never force-eject live media or remount an uncertain backing image RO.
        raise


def command_stop():
    ensure_detached()
    write_state('ready', 'Transfert terminé ; source conservée. Importer séparément.')


def command_reset():
    raise RuntimeError('Réinitialisation désactivée : source de secours conservée')


def command_import(recover_partial=None):
    ensure_detached()
    ensure_idle_storage()
    transfer.ordinary(IMAGE)
    ensure_no_local_access()
    loop = None
    mounted = False
    journal = None
    failure = None
    write_state('importing', 'Lecture exclusive de la source en lecture seule')
    remount('rw')
    try:
        journal = transfer.ImportJournal(IMAGE.parent)
        if recover_partial is not None:
            journal.recover_partial(recover_partial)
        MOUNT.mkdir(mode=0o700, parents=True, exist_ok=True)
        if MOUNT.is_symlink():
            raise RuntimeError('Point de montage symbolique interdit')
        ensure_detached()
        loop = attach_image(read_only=True)
        if not re.fullmatch(r'/dev/loop[0-9]+', loop):
            raise RuntimeError('Réponse losetup invalide')
        run(['fsck.exfat', '-n', loop], timeout=120)
        ensure_detached()
        run(['mount', '-t', 'exfat', '-o', 'ro,nosuid,nodev,noexec', loop, str(MOUNT)])
        mounted = True
        files = sorted(p for p in MOUNT.iterdir() if not p.is_symlink() and p.is_file()
                       and not p.name.startswith('.') and p.name.lower().endswith(SUPPORTED))
        if not files:
            raise RuntimeError('Aucune image ISO/IMG/RAW ; source conservée')
        imported = []
        for index, source in enumerate(files, 1):
            target = IMAGE.parent / (source.name[:-3] if source.name.lower().endswith('.xz') else source.name)
            last_update = [0.0]
            def progress(done, size):
                now = time.monotonic()
                if now - last_update[0] >= 1:
                    ensure_detached()
                    write_state('importing', 'Copie/vérification de ' + source.name,
                                done=index-1, total=len(files), current=source.name, bytes_done=done)
                    last_update[0] = now
            imported.append(journal.copy(source, target, progress))
        ensure_detached()
        journal.save('done', imported=imported)
    except BaseException as exc:
        failure = exc
        if journal:
            journal.save('interrupted', error=str(exc))
        write_state('interrupted', str(exc) + ' ; source et copies conservées')
        raise
    finally:
        try:
            if mounted:
                run(['umount', str(MOUNT)])
                mounted = False
            if loop:
                run(['losetup', '-d', loop])
            remount('ro')
        except Exception as cleanup:
            write_state('error', 'Nettoyage incomplet : ' + str(cleanup))
            if failure:
                raise RuntimeError(str(failure) + ' ; nettoyage : ' + str(cleanup)) from cleanup
            raise
    write_state('done', f'{len(imported)} image(s) vérifiée(s) ; conteneur source conservé',
                imported=imported, done=len(imported), total=len(imported), percent=100)


def command_status():
    print(json.dumps(transfer.observe(), ensure_ascii=False))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('status','diagnose','prepare','start','stop','import','reset','recover-link'))
    parser.add_argument('--allow-usb-reset', action='store_true')
    parser.add_argument('--recover-partial', metavar='SOURCE_NAME')
    parser.add_argument('--temporary-name')
    parser.add_argument('--target-name')
    args = parser.parse_args()
    if args.action == 'status':
        command_status()
        return
    if args.action == 'diagnose':
        print(json.dumps({'observation': transfer.observe(), 'recovery': transfer.recovery_report()},
                         ensure_ascii=False, indent=2))
        return
    def terminate(signum, _frame):
        raise InterruptedError('Signal ' + str(signum))
    signal.signal(signal.SIGTERM, terminate)
    with transfer.exclusive(transfer.STORAGE_LOCK), transfer.exclusive(LOCK):
        try:
            transfer.require_not_stopping()
            if args.action == 'recover-link':
                ensure_detached()
                ensure_idle_storage()
                remount('rw')
                try:
                    print(transfer.recover_link(IMAGE.parent, args.temporary_name, args.target_name))
                finally:
                    remount('ro')
            elif args.action == 'start':
                command_start(args.allow_usb_reset)
            elif args.action == 'import':
                command_import(args.recover_partial)
            else:
                globals()['command_' + args.action]()
        except Exception as exc:
            write_state('error', str(exc) + ' ; données conservées')
            raise


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        raise SystemExit('ERREUR : ' + str(exc))
