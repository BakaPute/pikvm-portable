#!/usr/bin/env python3

import glob
import json
import os
import re
import shutil
import subprocess
import time

import sys
sys.path.insert(0, "/usr/local/lib/pikvm-portable")
from pikvm_oled import MirrorDevice, AsyncCache, button_status
from pikvm_oled_nav import NavigationReader, render_navigation
from pikvm_config import READER as CONFIG, PageRotation
from pikvm_activity import latest, RUNTIME
from pikvm_oled_ui import render_status, render_message, render_idle


OLED_ADDR = 0x3C
MAX17048_ADDR = "0x36"

PAGE_DURATION = 10
REFRESH = .1


def cmd(args):
    try:
        p = subprocess.run(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=2
        )
        return p.returncode, p.stdout.strip()
    except Exception:
        return 1, ""


# ------------------------------------------------------------
# Batterie MAX17048
# ------------------------------------------------------------

def max17048_word(reg):
    try:
        hi = int(subprocess.check_output(
            ["i2cget", "-y", "1", MAX17048_ADDR, hex(reg), "b"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1
        ).strip(), 16)

        lo = int(subprocess.check_output(
            ["i2cget", "-y", "1", MAX17048_ADDR, hex(reg + 1), "b"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1
        ).strip(), 16)

        return (hi << 8) | lo

    except Exception:
        return None


def battery():
    vr = max17048_word(0x02)

    if vr is None:
        return None, None

    voltage = vr * 78.125 / 1_000_000

    percent = (voltage - 3.10) / (4.13 - 3.10) * 100.0
    percent = max(0, min(100, percent))

    return percent, voltage


def battery_charge_rate():
    raw = max17048_word(0x16)

    if raw is None:
        return None

    if raw & 0x8000:
        raw -= 65536

    return raw * 0.208


def battery_charging():
    rate = battery_charge_rate()

    if rate is None:
        return None

    return rate > 0.5


# ------------------------------------------------------------
# Wi-Fi
# ------------------------------------------------------------

def network_info():
    rc,out=cmd(['iw','dev','wlan0','link'])
    connected=None if rc!=0 else False if 'Not connected' in out else True if 'Connected to ' in out else None
    ssid=signal=None
    if rc==0:
        for line in out.splitlines():
            line=line.strip()
            if line.startswith('SSID:'):ssid=line.split(':',1)[1].strip()
            elif line.startswith('signal:'):
                match=re.search(r'(-?\d+)',line)
                if match:signal=int(match.group(1))
    rc,address=cmd(['ip','-4','-o','addr','show','dev','wlan0'])
    match=re.search(r'inet\s+([0-9.]+)',address) if rc==0 else None
    return {'connected':connected,'ssid':ssid,'dbm':signal,'ip':match.group(1) if match else None}


def wifi():
    data=network_info();return data['ssid'],data['dbm']


def wifi_level(dbm):
    if dbm is None:
        return 0

    if dbm >= -50:
        return 5
    if dbm >= -60:
        return 4
    if dbm >= -70:
        return 3
    if dbm >= -80:
        return 2

    return 1


def ip_address():
    return network_info()['ip'] or '-'


# ------------------------------------------------------------
# USB gadget
# ------------------------------------------------------------

def usb_state():
    states = []

    for path in glob.glob("/sys/class/udc/*/state"):
        try:
            with open(path) as f:
                states.append(f.read().strip())
        except Exception:
            pass

    if not states:
        return "?"

    if "configured" in states:
        return "OK"

    if "addressed" in states:
        return "WAIT"

    if "powered" in states:
        return "POWER"

    if "not attached" in states:
        return "OFF"

    return states[0][:6].upper()


# ------------------------------------------------------------
# HDMI / CSI
# ------------------------------------------------------------

def hdmi_state():
    if not os.path.exists("/usr/bin/v4l2-ctl"):
        return "?"

    devices = sorted(glob.glob("/dev/video*"))

    for dev in devices:
        rc, out = cmd([
            "v4l2-ctl",
            "-d", dev,
            "--query-dv-timings"
        ])

        if rc != 0:
            continue

        width = None
        height = None

        mw = re.search(r"Width:\s*(\d+)", out, re.I)
        mh = re.search(r"Height:\s*(\d+)", out, re.I)

        if mw:
            width = mw.group(1)

        if mh:
            height = mh.group(1)

        if width and height:
            return f"{width}x{height}"

        if out:
            return "ON"

    return "?"


# ------------------------------------------------------------
# Température CPU
# ------------------------------------------------------------

def cpu_temp():
    try:
        with open("/sys/class/thermal/thermal_zone0/temp") as f:
            return int(f.read().strip()) / 1000
    except Exception:
        return None


# ------------------------------------------------------------
# Utilisation CPU
# ------------------------------------------------------------

_cpu_previous = None


def cpu_usage():
    global _cpu_previous

    try:
        with open("/proc/stat") as f:
            values = [
                int(value)
                for value in f.readline().split()[1:9]
            ]

        (
            user,
            nice,
            system,
            idle,
            iowait,
            irq,
            softirq,
            steal,
        ) = values

        idle_all = idle + iowait

        non_idle = (
            user
            + nice
            + system
            + irq
            + softirq
            + steal
        )

        total = idle_all + non_idle

        current = (
            total,
            idle_all,
        )

        if _cpu_previous is None:
            _cpu_previous = current
            return None

        total_delta = (
            current[0]
            - _cpu_previous[0]
        )

        idle_delta = (
            current[1]
            - _cpu_previous[1]
        )

        _cpu_previous = current

        if total_delta <= 0:
            return 0.0

        usage = (
            100.0
            * (total_delta - idle_delta)
            / total_delta
        )

        return max(
            0.0,
            min(100.0, usage)
        )

    except Exception:
        return None


# ------------------------------------------------------------
# Transfert USB
# ------------------------------------------------------------

TRANSFER_STATE = (
    "/run/pikvm-usb-transfer-state.json"
)

TRANSFER_IMAGE = (
    "/var/lib/kvmd/msd/.USB-TRANSFER.img"
)

TRANSFER_LUN = (
    "/sys/kernel/config/usb_gadget/kvmd/"
    "functions/mass_storage.usb0/lun.0/file"
)

MSD_PATH = "/var/lib/kvmd/msd"


def transfer_info():
    from pikvm_transfer import observe
    data = observe()
    data['connected'] = data['drive']['transfer_active']
    data['active'] = bool(data['busy'] or data['connected'])
    return data


def msd_free_space():
    try:
        free = shutil.disk_usage(
            MSD_PATH
        ).free

        return (
            free / (1024 ** 3)
        )

    except Exception:
        return None


# ------------------------------------------------------------
# Uptime
# ------------------------------------------------------------

def uptime():
    try:
        with open("/proc/uptime") as f:
            seconds = int(float(f.read().split()[0]))

        hours = seconds // 3600
        minutes = (seconds % 3600) // 60

        if hours >= 24:
            days = hours // 24
            hours %= 24
            return f"{days}d{hours}h"

        return f"{hours}h{minutes:02d}"

    except Exception:
        return "?"


def memory_info():
    try:
        with open('/proc/meminfo') as source:
            values={line.split(':',1)[0]:int(line.split(':',1)[1].split()[0]) for line in source if line.startswith(('MemTotal:','MemAvailable:'))}
        total=values['MemTotal'];available=values['MemAvailable']
        return {'percent':round(100*(total-available)/total),'available_mb':available//1024}
    except (OSError,ValueError,KeyError,ZeroDivisionError):return {'percent':None,'available_mb':None}


def kvm_state():
    _,state=cmd(['systemctl','is-active','kvmd.service'])
    return True if state=='active' else False if state in ('inactive','failed') else None


def drive_info():
    result={}
    for index in (0,1):
        try:
            base=f'/sys/kernel/config/usb_gadget/kvmd/functions/mass_storage.usb{index}/lun.0'
            with open(base+'/file') as file:attached=file.read().strip()
            with open(base+'/cdrom') as file:cdrom=file.read().strip()
            if cdrom not in ('0','1'):raise ValueError()
            result[str(index)]={'known':True,'attached':bool(attached),'cdrom':cdrom=='1'}
        except (OSError,ValueError):result[str(index)]={'known':False}
    return result


ANIMATED=False
PAGE_STARTED=0


def show_status(device,page,data,remaining):
    global ANIMATED
    started=time.perf_counter()
    rendered=render_status(page,data,CONFIG.get(),remaining,max(0,time.monotonic()-PAGE_STARTED))
    ANIMATED=rendered.animated
    device.render_ms=(time.perf_counter()-started)*1000
    device.display(rendered.image)


def page_main(device,remaining):
    percent,voltage=battery();ssid,dbm=wifi()
    show_status(device,'main',{'percent':percent,'voltage':voltage,'charging':battery_charging(),
        'ssid':ssid,'dbm':dbm,'ip':ip_address(),'usb':usb_state(),'kvm':kvm_state(),'hdmi':hdmi_state()},remaining)


def page_battery(device,remaining):
    percent,voltage=battery()
    show_status(device,'battery',{'percent':percent,'voltage':voltage,'charging':battery_charging()},remaining)


def page_system(device,remaining):
    memory=memory_info()
    show_status(device,'system',{'cpu':cpu_usage(),'temperature':cpu_temp(),'uptime':uptime(),
        'ram':memory['percent'],'available_mb':memory['available_mb']},remaining)


def page_network(device,remaining):
    show_status(device,'network',network_info(),remaining)


def page_system_details(device,remaining):
    memory=memory_info()
    show_status(device,'system_details',{'available_mb':memory['available_mb'],'uptime':uptime()},remaining)


def page_network_details(device,remaining):
    show_status(device,'network_details',network_info(),remaining)


def page_usb(device,remaining):
    show_status(device,'usb',{'drives':drive_info(),'usb':usb_state()},remaining)


def page_usb_transfer(device,remaining):
    show_status(device,'transfer',{**transfer_info(),'free':msd_free_space()},remaining)


# ------------------------------------------------------------
# Main
# ------------------------------------------------------------

def display_navigation(device,model,values,now,notice=''):
    if not model or model['context']['screen']=='status':return False
    context=model['context'];revision=context['navigation_id']
    if getattr(device,'menu_revision',None)!=revision:
        device.menu_revision=revision;device.menu_started=now;device.menu_animated=True
    phase=now-device.menu_started
    animation=int(phase*min(10,values['oled_scroll_speed']/2)) if device.menu_animated and values['oled_animations'] and values['animations'] else 0
    key=(revision,model['held'],model['remaining'],CONFIG.revision,animation,notice)
    device.source='menu';device.set_context(**context);device.navigation_at=model['event_at']
    if key!=getattr(device,'menu_render_key',None):
        began=time.perf_counter()
        try:surface=render_navigation(model,values,phase)
        except Exception as error:
            if model['context']['screen']!='qr':raise
            # Preserve the navigation context, so a virtual short can leave an
            # unavailable QR/menu instead of trapping the remote user.
            surface=render_message('Affichage indisponible',[type(error).__name__,'Clic ou maintien : retour'],values,'Le bouton reste disponible')
        if notice:
            surface.draw.rectangle((0,52,127,63),fill=0);surface.footer(notice)
        device.menu_animated=surface.animated;device.render_ms=(time.perf_counter()-began)*1000
        device.display(surface.image);device.menu_render_key=key
    else:device.refresh()
    return True

def main():
    global PAGE_STARTED
    cache = AsyncCache()
    defaults = {'battery':(None,None), 'battery_charging':None,
                'usb_state':'?', 'hdmi_state':'?', 'cpu_temp':None, 'cpu_usage':None,
                'transfer_info':{}, 'msd_free_space':None, 'uptime':'?',
                'memory_info':{'percent':None,'available_mb':None},'kvm_state':None,'drive_info':{}}
    for name, default in defaults.items():
        globals()[name] = cache.wrap(globals()[name], default, interval=5 if name in ('kvm_state','hdmi_state','drive_info') else 1)
    globals()['network_info']=cache.wrap(network_info,{'connected':None,'ssid':None,'dbm':None,'ip':None},interval=2)
    device = MirrorDevice("status")
    navigation=NavigationReader()

    rotation=PageRotation()
    renderers={'main':page_main,'battery':page_battery,'system':page_system,'system_details':page_system_details,
               'network':page_network,'network_details':page_network_details,'usb':page_usb,'transfer':page_usb_transfer}
    last_render=None
    last_request=0

    while True:
        try:
            now = time.monotonic()

            values=CONFIG.get()
            transfer=transfer_info();percent,_=battery()
            notice=f'Batterie critique {percent:.0f}%' if percent is not None and percent<=values['battery_critical'] else 'Erreur transfert USB' if transfer.get('state')=='error' else ''
            model=navigation.read(button_status())
            if display_navigation(device,model,values,now,notice):
                last_render=None
                time.sleep(REFRESH)
                continue
            device.source='status';device.navigation_at=model.get('event_at') if model else None
            request=latest('button')
            command=None
            if request and request['monotonic']>last_request:
                last_request=request['monotonic'];command=request.get('request')
            urgent=transfer.get('state') in ('importing','preparing','starting','stopping','error')
            page,remaining=rotation.choose(values,now,bool(transfer.get('active')),percent,command,critical_transfer=urgent)
            idle={}
            try:
                path=RUNTIME/'idle.json'
                if not path.is_symlink() and path.stat().st_size<4096:
                    idle=json.loads(path.read_text())
                    if not 0<=now-idle.get('monotonic',0)<=15:idle={}
            except (OSError,ValueError,TypeError):pass
            idle_action=idle.get('action','none')
            # Critical battery and transfer information always override blanking.
            if urgent or transfer.get('active') or (percent is not None and percent<=values['battery_low']):idle_action='none'
            device.set_context(**{**(model['context'] if model else {}),'screen':'status','page':'page_'+page,'remaining':remaining,'idle':idle_action})
            if page!=getattr(device,'last_page',None):PAGE_STARTED=now;device.last_page=page
            animation=int((now-PAGE_STARTED)*min(10,values['oled_scroll_speed']/2)) if ANIMATED and values['oled_animations'] and values['animations'] else 0
            render_key=(page,remaining,cache.revision,CONFIG.revision,idle_action,animation)
            if render_key!=last_render:
                if idle_action in ('off','screen'):
                    device.display(render_idle(idle_action,values).image)
                else:renderers[page](device,remaining if values['oled_auto'] else None)
                last_render=render_key
            else:device.refresh()

        except Exception as e:
            device.set_context(screen='error',error_type=type(e).__name__)
            device.display(render_message('Erreur OLED',[type(e).__name__,'Télémétrie indisponible'],CONFIG.get(),help_text='Nouvelle tentative automatique').image)

        time.sleep(REFRESH)


if __name__ == "__main__":
    main()
