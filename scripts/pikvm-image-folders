#!/usr/bin/env python3
"""Gestion des dossiers dans le stockage MSD PiKVM, sans toucher à OTG."""
import fcntl
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path('/var/lib/kvmd/msd')
LUN = Path('/sys/kernel/config/usb_gadget/kvmd/functions/mass_storage.usb0/lun.0/file')
LOCK = Path('/run/pikvm-image-folders.lock')
EXT = {'.iso', '.img', '.raw'}
ACTIVE_STATES = {'starting', 'connected', 'stopping', 'importing', 'preparing'}


def relative(value, allow_root=False):
    if not isinstance(value, str):
        raise ValueError('Chemin invalide.')
    if not value:
        if allow_root:
            return Path('.')
        raise ValueError('Le chemin ne peut pas être vide.')
    if value.startswith('/') or '\\' in value or '\x00' in value or len(value) > 700:
        raise ValueError('Chemin interdit.')
    parts = value.split('/')
    if any(not x or x in ('.', '..') or x.startswith('.') or any(ord(c) < 32 for c in x) for x in parts):
        raise ValueError('Composant de chemin interdit.')
    return Path(*parts)


def leaf(value):
    result = relative(value)
    if len(result.parts) != 1 or len(result.name) > 120 or result.name == 'lost+found':
        raise ValueError('Nom de dossier ou fichier interdit.')
    return result.name


def safe_path(value, *, root_allowed=False):
    rel = relative(value, allow_root=root_allowed)
    path = ROOT / rel
    current = ROOT
    for part in rel.parts:
        current = current / part
        if current.is_symlink():
            raise ValueError('Les liens symboliques sont interdits.')
    if not path.resolve(strict=False).is_relative_to(ROOT.resolve(strict=True)):
        raise ValueError('Chemin hors du stockage.')
    return path


def run(args):
    proc = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if proc.returncode:
        raise RuntimeError((proc.stderr or proc.stdout).strip() or 'Commande échouée.')


def transfer_active():
    proc = subprocess.run(['/usr/local/bin/pikvm-usb-transfer', 'status'],
                          capture_output=True, text=True, timeout=10)
    if proc.returncode:
        raise RuntimeError('Impossible de vérifier le transfert USB.')
    lines = [line for line in proc.stdout.splitlines() if line.startswith('{')]
    if not lines:
        raise RuntimeError('Statut USB indisponible.')
    data = json.loads(lines[-1])
    return bool(data.get('drive', {}).get('transfer_active') or data.get('state') in ACTIVE_STATES)


def check_idle():
    if not ROOT.is_dir():
        raise RuntimeError('Stockage MSD indisponible.')
    if LUN.read_text().strip():
        raise RuntimeError('Déconnecte d’abord le Drive du PC cible.')
    if transfer_active():
        raise RuntimeError('Transfert/import USB en cours.')
    # Le plugin MSD crée .__<nom>.incomplete pendant un upload navigateur.
    # Ne jamais remonter RO pendant une écriture qui utilise cette partition.
    for base, dirs, files in os.walk(ROOT, followlinks=False):
        dirs[:] = [d for d in dirs if not d.startswith('.') and d != 'lost+found']
        if any(name.startswith('.__') and (name.endswith('.incomplete') or name.endswith('.part')) for name in files):
            raise RuntimeError('Importation incomplète ou en cours. Attends sa fin ou nettoie le fichier dans Drive.')


def directories():
    folders = []
    for base, dirs, _ in os.walk(ROOT, followlinks=False):
        dirs[:] = sorted(d for d in dirs if not d.startswith('.') and d != 'lost+found'
                         and not (Path(base) / d).is_symlink())
        for d in dirs:
            folders.append((Path(base) / d).relative_to(ROOT).as_posix())
    return {'folders': folders}


def execute(action, data):
    if action == 'list':
        return directories()
    check_idle()
    # Nouveau contrôle après remontage en RW pour éviter une collision grossière.
    run(['kvmd-helper-otgmsd-remount', 'rw'])
    try:
        check_idle()
        if action == 'mkdir':
            parent = safe_path(data.get('parent', ''), root_allowed=True)
            name = leaf(data.get('name'))
            if not parent.is_dir():
                raise ValueError('Dossier parent inexistant.')
            dest = parent / name
            dest.mkdir(mode=0o755, exist_ok=False)
            result = {'path': dest.relative_to(ROOT).as_posix()}
        elif action == 'rmdir':
            path = safe_path(data.get('path'))
            if not path.is_dir():
                raise ValueError('Dossier introuvable.')
            path.rmdir()  # Exclusivement vide, jamais récursif.
            result = {'deleted': data.get('path')}
        elif action == 'rename_dir':
            path = safe_path(data.get('path'))
            name = leaf(data.get('name'))
            if not path.is_dir():
                raise ValueError('Dossier introuvable.')
            dest = path.with_name(name)
            if dest.exists():
                raise FileExistsError('Ce nom existe déjà.')
            path.rename(dest)
            result = {'path': dest.relative_to(ROOT).as_posix()}
        elif action in ('move_file', 'rename_file'):
            source = safe_path(data.get('source'))
            if not source.is_file() or source.is_symlink() or source.suffix.lower() not in EXT:
                raise ValueError('Image introuvable ou format interdit.')
            if (source.parent / f'.__{source.name}.incomplete').exists():
                raise RuntimeError('Cette image est encore en cours d’importation.')
            if action == 'move_file':
                target_dir = safe_path(data.get('folder', ''), root_allowed=True)
                if not target_dir.is_dir():
                    raise ValueError('Dossier de destination inexistant.')
                dest = target_dir / source.name
            else:
                name = leaf(data.get('name'))
                if Path(name).suffix.lower() != source.suffix.lower():
                    raise ValueError('L’extension doit rester identique.')
                dest = source.with_name(name)
            if dest == source:
                return {'path': source.relative_to(ROOT).as_posix()}
            if dest.exists():
                raise FileExistsError('Une image portant ce nom existe déjà dans le dossier.')
            source.rename(dest)
            result = {'path': dest.relative_to(ROOT).as_posix()}
        else:
            raise ValueError('Action inconnue.')
        os.sync()
        return result
    finally:
        # Le stockage doit retrouver son montage RO, même si une opération échoue.
        run(['kvmd-helper-otgmsd-remount', 'ro'])


def main():
    if len(sys.argv) != 2:
        raise SystemExit('Usage: pikvm-image-folders <action> (JSON sur stdin)')
    action = sys.argv[1]
    data = json.loads(sys.stdin.read() or '{}')
    if action == 'list':
        result = execute(action, data)
    else:
        with LOCK.open('w') as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            result = execute(action, data)
    print(json.dumps(result, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1)
