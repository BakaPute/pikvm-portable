#!/usr/bin/env python3

import json
import os
import subprocess
import time


TIMEOUT = 3600
CHECK_INTERVAL = 5

HID_FILE = "/run/kvmd/pikvm-hid-last-activity"
STATE_FILE = "/run/pikvm-auto-shutdown-state.json"
POWEROFF_MARKER = "/run/pikvm-poweroff-requested"

VIDEO_DEVICE = "/dev/kvmd-video"


def hdmi_present():
    try:
        result = subprocess.run(
            [
                "v4l2-ctl",
                "-d", VIDEO_DEVICE,
                "--query-dv-timings",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )

        return result.returncode == 0

    except Exception:
        return False


def hid_activity_token():
    """
    Retourne le contenu du marqueur HID.

    On ne compare volontairement PAS son horodatage à l'heure
    système, car celle-ci peut changer brutalement après une
    synchronisation NTP au démarrage.
    """
    try:
        with open(HID_FILE, "r") as file:
            return file.read().strip()
    except Exception:
        return None


def write_state(data):
    try:
        with open(STATE_FILE, "w") as file:
            json.dump(data, file)
    except Exception:
        pass


def main():

    print(
        f"PiKVM auto shutdown started - timeout={TIMEOUT}s",
        flush=True,
    )

    # time.monotonic() n'est jamais affecté par une correction
    # de l'heure système ou une synchronisation NTP.
    last_active = time.monotonic()

    # On mémorise simplement la valeur du fichier HID.
    # Lorsqu'elle change, une activité clavier/souris a eu lieu.
    last_hid_token = hid_activity_token()

    while True:

        now = time.monotonic()

        hdmi = hdmi_present()
        hid_token = hid_activity_token()

        if hdmi:
            # Tant qu'un signal HDMI existe, le compteur
            # reste continuellement remis à zéro.
            last_active = now

        elif (
            hid_token is not None
            and hid_token != last_hid_token
        ):
            # Une nouvelle activité clavier/souris a été détectée.
            last_active = now

        last_hid_token = hid_token

        idle = max(0, now - last_active)
        remaining = max(0, TIMEOUT - idle)

        state = {
            "hdmi": hdmi,
            "idle_seconds": round(idle, 1),
            "remaining_seconds": round(remaining, 1),
            "timeout_seconds": TIMEOUT,
        }

        write_state(state)

        if not hdmi and idle >= TIMEOUT:

            print(
                "No HDMI and no HID activity: powering off",
                flush=True,
            )

            with open(POWEROFF_MARKER, "w") as file:
                file.write("auto-shutdown\n")

            subprocess.run(
                ["systemctl", "poweroff"],
                check=False,
            )

            return

        time.sleep(CHECK_INTERVAL)


if __name__ == "__main__":
    main()
