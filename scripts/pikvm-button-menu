#!/usr/bin/env python3
"""Physical/logical button coordinator; graphics belong to the OLED producer."""
import os
import re
import shlex
import struct
import subprocess
import sys
import time
from pathlib import Path
sys.path.insert(0, "/usr/local/lib/pikvm-portable")
from pikvm_oled import LogicalButton, ButtonReader, BUTTON_HEARTBEAT, private_directory, RUNTIME
from pikvm_gpio import pinctrl_sample, select_reader
from pikvm_config import READER as CONFIG, Configuration
from pikvm_activity import event as activity_event
from pikvm_oled_nav import Navigation
from pikvm_oled_control import Control
from pikvm_iso import Library

WPA_CONF=Path('/etc/wpa_supplicant/wpa_supplicant-wlan0.conf')
HOTSPOT_ENV=Path('/etc/kvmd/pikvm-hotspot.env')
HOTSPOT_STATE=Path('/run/pikvm-hotspot-active')
INPUT=LogicalButton()


def cmd(args,timeout=3):
    p=subprocess.run(args,text=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,timeout=timeout,check=True)
    return p.stdout.strip()


def physical_button_down():
    try:return pinctrl_sample()
    except Exception:return None


def current_ssid():

    if HOTSPOT_STATE.exists():
        return None

    try:

        out = cmd(
            ["iw", "dev", "wlan0", "link"],
            3
        )

        m = re.search(
            r"^\s*SSID:\s*(.+)$",
            out,
            re.M
        )

        if m:
            return m.group(1).strip()

    except Exception:
        pass

    return None


def unquote(value):

    value = value.strip()

    if (
        len(value) >= 2
        and value[0] == '"'
        and value[-1] == '"'
    ):

        value = value[1:-1]

    value = value.replace(
        r'\"',
        '"'
    )

    value = value.replace(
        r'\\',
        '\\'
    )

    return value


def wifi_password(ssid):

    if not ssid:
        return None

    if not WPA_CONF.exists():
        return None

    data = WPA_CONF.read_text(
        errors="ignore"
    )

    blocks = re.findall(
        r"network\s*=\s*\{(.*?)\}",
        data,
        re.S
    )

    for block in blocks:

        mssid = re.search(
            r'^\s*ssid\s*=\s*("(?:\\.|[^"])*")',
            block,
            re.M
        )

        if not mssid:
            continue

        if unquote(
            mssid.group(1)
        ) != ssid:

            continue

        patterns = [
            r'^\s*#psk\s*=\s*("(?:\\.|[^"])*")',
            r'^\s*psk\s*=\s*("(?:\\.|[^"])*")'
        ]

        for pattern in patterns:

            m = re.search(
                pattern,
                block,
                re.M
            )

            if m:

                return unquote(
                    m.group(1)
                )

    return None


def load_hotspot():

    values = {}

    if not HOTSPOT_ENV.exists():
        return values

    for line in HOTSPOT_ENV.read_text(
        errors="ignore"
    ).splitlines():

        line = line.strip()

        if (
            not line
            or line.startswith("#")
            or "=" not in line
        ):
            continue

        key, value = line.split(
            "=",
            1
        )

        try:

            parts = shlex.split(value)

            values[key] = (
                parts[0]
                if parts
                else ""
            )

        except Exception:

            values[key] = value.strip(
                "\"'"
            )

    return values


def wifi_escape(value):

    value = str(value)

    replacements = [
        ("\\", "\\\\"),
        (";", "\\;"),
        (",", "\\,"),
        (":", "\\:"),
        ('"', '\\"')
    ]

    for old, new in replacements:

        value = value.replace(
            old,
            new
        )

    return value


class Backend:
    def __init__(self):self.iso=Library();self.preferences=Configuration()
    def status_page(self,page):activity_event('button',request=page)
    def library(self,folder,scope='browse'):
        state=self.iso.state()
        if scope=='browse':return state,self.iso.entries(state,folder)
        values=self.preferences.read()['values'];paths=values['iso_favorites' if scope=='favorites' else 'iso_recent']
        images=state.get('storage',{}).get('images',{})
        entries=[{'name':'Retour','kind':'back'}]
        if scope=='favorites' and values['iso_favorite']:
            entries.append({'name':values['iso_favorite'],'path':values['iso_favorite'],'kind':'folder'})
        for path in paths:
            info=images.get(path,{})
            entries.append({'name':path,'path':path,'kind':'file','complete':info.get('complete') is True,'size':info.get('size')})
        return state,entries
    def remember(self,key,name,toggle=False):
        document=self.preferences.read()
        if not document['healthy']:raise RuntimeError('Préférences illisibles ; liste conservée')
        values=document['values'];old=values[key];present=name in old
        values[key]=[p for p in old if p!=name]
        if not toggle or not present:values[key]=[name,*values[key]][:12]
        self.preferences.save(values,document['revision'])
    def favorite(self,name):
        self.iso.ordinary(name);self.remember('iso_favorites',name,True)
    def connect(self,name,cdrom):
        state=self.iso.connect(name,cdrom)
        try:self.remember('iso_recent',name)
        except Exception:state['portable_notice']='ISO connectée ; historique non enregistré'
        return state
    def eject(self,confirmed):return self.iso.eject(confirmed)
    def qr(self):
        if HOTSPOT_STATE.exists():
            values=load_hotspot();ssid=values.get('HOTSPOT_SSID');password=values.get('HOTSPOT_PASS')
        else:ssid=current_ssid();password=wifi_password(ssid)
        if not ssid or not password:raise RuntimeError('Identifiants Wi-Fi indisponibles')
        private_directory(RUNTIME)
        target=RUNTIME/'qr.png';temporary=RUNTIME/'.qr-new.png'
        if target.is_symlink() or temporary.is_symlink():raise RuntimeError('Chemin QR invalide')
        payload='WIFI:T:WPA;S:'+wifi_escape(ssid)+';P:'+wifi_escape(password)+';;'
        try:
            # No secret in argv, errors, navigation JSON, logs or repository.
            with temporary.open('wb') as output:
                os.chmod(temporary,0o600)
                subprocess.run(['qrencode','-t','PNG','-s','1','-m','0','-o','-'],input=payload.encode(),stdout=output,
                               stderr=subprocess.DEVNULL,timeout=5,check=True)
            with temporary.open('rb') as source:header=source.read(24)
            if len(header)!=24 or header[:8]!=b'\x89PNG\r\n\x1a\n':raise RuntimeError('Format QR invalide')
            width,height=struct.unpack('>II',header[16:24])
            if width!=height or not 1<=width<=56:raise RuntimeError('QR trop dense pour cet écran')
            os.replace(temporary,target)
            return str(time.monotonic_ns())
        except Exception:raise RuntimeError('QR Wi-Fi indisponible') from None
        finally:temporary.unlink(missing_ok=True)
    def sensitive(self,operation,permit):
        kind='network' if operation=='hotspot' else 'power'
        if operation not in ('restart','shutdown','hotspot'):raise RuntimeError('Action interdite')
        permit.consume(kind,time.monotonic())
        if kind=='power':
            from pikvm_transfer import require_idle_for_power,reserve_poweroff
            require_idle_for_power()
            if operation=='shutdown':reserve_poweroff()
            args=['systemctl','poweroff'] if operation=='shutdown' else ['systemctl','restart','kvmd.service','kvmd-nginx.service']
        else:
            args=['/usr/local/bin/pikvm-hotspot','off' if HOTSPOT_STATE.exists() else 'on']
        try:
            subprocess.run(args,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=30,check=True)
        except Exception:raise RuntimeError('Action refusée ou délai dépassé ; vérifier les services') from None
        return None


def main():
    read,resource,diagnostic=select_reader(physical_button_down)
    reader=ButtonReader(read,resource=resource,diagnostic=diagnostic)
    navigation=Navigation(Backend(),CONFIG.get)
    control=Control(INPUT,navigation,CONFIG.get,activity_event)
    INPUT.heartbeat=BUTTON_HEARTBEAT
    INPUT.input_status=lambda:{**reader.status(),'loop_max_ms':round(control.max_gap_ms,2),'loop_stalls':control.stalls}
    try:
        with INPUT.listen():
            while True:
                control.step(reader.read())
                time.sleep(.02)
    finally:
        reader.close();navigation.worker.close()


if __name__=='__main__':main()
