    )

    show(im)


def confirm_delete(image):

    reset_scroll()

    deadline = (
        time.monotonic()
        + ISO_CONFIRM_TIMEOUT
    )

    while True:

        while not button_down():

            if time.monotonic() >= deadline:

                return False

            draw_iso_confirm(
                image,
                0,
            )

            time.sleep(0.12)


        start = time.monotonic()


        while button_down():

            held = (
                time.monotonic()
                - start
            )

            draw_iso_confirm(
                image,
                held,
            )

            if held >= ISO_CONFIRM:

                wait_release()

                return True

            time.sleep(0.05)


        held = (
            time.monotonic()
            - start
        )

        time.sleep(0.06)


        # Un clic court annule immédiatement.
        if held < SHORT_CLICK:

            return False


        # Entre clic court et 3 secondes :
        # aucune suppression.
        return False


def run_iso_manager():

    if usb_transfer_busy():

        message(
            "ISO / IMG",
            "Transfert USB actif",
            2,
        )

        return


    images = image_files()

    if not images:

        message(
            "ISO / IMG",
            "Aucune image",
            2,
        )

        return


    index = 0

    last_action = time.monotonic()

    reset_scroll()


    while True:

        images = image_files()

        if not images:

            message(
                "ISO / IMG",
                "Aucune image",
                2,
            )

            return


        if index >= len(images):

            index = 0


        deadline = (
            last_action
            + ISO_MANAGER_TIMEOUT
        )


        # ====================================================
        # ATTENTE
        # ====================================================

        while not button_down():

            if time.monotonic() >= deadline:

                return

            remaining = max(
                0,
                int(
                    deadline
                    - time.monotonic()
                    + 0.999
                ),
            )

            draw_iso_browser(
                images,
                index,
                0,
                remaining,
            )

            time.sleep(0.12)


        start = time.monotonic()


        # ====================================================
        # BOUTON MAINTENU
        # ====================================================

        while button_down():

            held = (
                time.monotonic()
                - start
            )

            draw_iso_browser(
                images,
                index,
                held,
            )

            time.sleep(0.05)


        held = (
            time.monotonic()
            - start
        )

        time.sleep(0.06)

        last_action = time.monotonic()


        # ====================================================
        # CLIC COURT = IMAGE SUIVANTE
        # ====================================================

        if held < SHORT_CLICK:

            index = (
                index + 1
            ) % len(images)

            reset_scroll()

            continue


        # ====================================================
        # HOLD 2s = DEMANDE SUPPRESSION
        # ====================================================

        if held >= ISO_DELETE:

            image = images[index]

            if not confirm_delete(
                image
            ):

                message(
                    "Suppression",
                    "annulee",
                    0.8,
                )

                reset_scroll()
                last_action = time.monotonic()

                continue


            if usb_transfer_busy():

                message(
                    "Suppression refusee",
                    "Transfert USB actif",
                    2,
                )

                reset_scroll()
                last_action = time.monotonic()

                continue


            if drive_connected():

                message(
                    "Suppression refusee",
                    "Drive connecte",
                    2,
                )

                reset_scroll()
                last_action = time.monotonic()

                continue


            ok, result = delete_image(
                image
            )


            if ok:

                message(
                    "Image supprimee",
                    image.name,
                    1.5,
                )

            else:

                message(
                    "Erreur suppression",
                    result,
                    2,
                )


            images = image_files()

            if not images:

                message(
                    "ISO / IMG",
                    "Aucune image",
                    1.5,
                )

                return


            if index >= len(images):

                index = 0

            reset_scroll()
            last_action = time.monotonic()

            continue


        # ====================================================
        # ENTRE 0.8 ET 2s
        # ====================================================

        message(
            "Trop court",
            "2s pour supprimer",
            1,
        )

        reset_scroll()
        last_action = time.monotonic()


def message(line1, line2="", delay=1):

    im = frame()
    d = ImageDraw.Draw(im)

    draw_text(
        d,
        (0, 16),
        fit(line1, 126),
        True
    )

    if line2:

        draw_text(
            d,
            (0, 32),
            fit(line2, 126)
        )

    show(im)

    if delay:
        time.sleep(delay)


def show_qr(ssid, password):

    if not ssid or not password:

        message(
            "QR indisponible",
            "SSID/PASS absent",
            2
        )

        return


    try:

        payload = (
            "WIFI:T:WPA;"
            f"S:{wifi_escape(ssid)};"
            f"P:{wifi_escape(password)};;"
        )

        subprocess.run(
            [
                "qrencode",
                "-t", "PNG",
                "-l", "L",
                "-m", "0",
                "-s", "1",
                "-o", QR_FILE,
                payload
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

        qr = Image.open(
            QR_FILE
        ).convert("1")


        factor = max(
            1,
            58 // max(
                qr.width,
                qr.height
            )
        )

        qr = qr.resize(
            (
                qr.width * factor,
                qr.height * factor
            ),
            Image.Resampling.NEAREST
        )


    except Exception as e:

        message(
            "Erreur QR",
            str(e),
            2
        )

        return


    # On attend que le bouton ayant déclenché
    # le QR soit complètement relâché.
    wait_release()


    # Le SSID repart du début à chaque ouverture du QR.
    reset_scroll()


    # Le QR reste affiche sans limite de temps.
    # Un clic court permet de revenir.
    while True:

        im = frame()


        # ====================================================
        # QR CODE A GAUCHE
        # ====================================================

        white = Image.new(
            "1",
            (64, 64),
            255
        )

        im.paste(
            white,
            (0, 0)
        )


        x = (
            64 - qr.width
        ) // 2

        y = (
            64 - qr.height
        ) // 2

        im.paste(
            qr,
            (x, y)
        )


        # ====================================================
        # INFORMATIONS A DROITE
        # ====================================================

        d = ImageDraw.Draw(im)

        draw_text(
            d,
            (68, 3),
            "SCAN WIFI",
            True
        )


        draw_text(
            d,
            (68, 16),
            "SSID:"
        )


        # fit() est recalculé à chaque frame :
        # le SSID défile réellement.
        draw_text(
            d,
            (68, 28),
            fit(
                ssid,
                58
            )
        )


        draw_text(
            d,
            (68, 45),
            "clic retour"
        )


        show(im)


        # ====================================================
        # CLIC = RETOUR
        # ====================================================

        if button_down():

            wait_release()

            break


        # Environ 8 rafraîchissements / seconde
        time.sleep(0.12)

def restart_pikvm():

    message(
        "RESTART PiKVM",
        "Services...",
        0.5
    )

    subprocess.run(
        [
            "systemctl",
            "restart",
            "kvmd.service",
            "kvmd-nginx.service"
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

    time.sleep(2)


def poweroff():

    try:

        Path(
            "/run/pikvm-poweroff-requested"
        ).write_text("1\n")

    except Exception:
        pass

    message(
        "POWER OFF",
        "Arret en cours...",
        0.5
    )

    subprocess.Popen(
        [
            "systemctl",
            "poweroff"
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )


def hotspot_toggle(enable):

    if enable:

        message(
            "DEPANNAGE",
            "Activation...",
            0.2
        )

        action = "on"

    else:

        message(
            "DEPANNAGE",
            "Retour WiFi...",
            0.2
        )

        action = "off"

    try:

        p = subprocess.run(
            [
                "/usr/local/bin/pikvm-hotspot",
                action
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=25
        )

        if p.returncode != 0:

            message(
                "Erreur hotspot",
                p.stdout.splitlines()[-1]
                if p.stdout
                else "",
                3
            )

            return False

        return True

    except Exception as e:

        message(
            "Erreur hotspot",
            str(e),
            3
        )

        return False


def draw_menu(index, held=0):

    if index == 0:
        draw_power(held)

    elif index == 1:
        draw_wifi(held)

    elif index == 2:
        draw_rescue(held)

    else:
        draw_iso_page(held)

def draw_rescue_power(held=0):

    im = frame()
    d = ImageDraw.Draw(im)

    draw_text(
        d,
        (0, 0),
        "POWER",
        True
    )

    draw_text(
        d,
        (72, 0),
        "clic retour"
    )


    draw_text(
        d,
        (0, 14),
        "RESTART 2s"
    )

    bar(
        d,
        0,
        25,
        126,
        8,
        held / POWER_RESTART
    )


    draw_text(
        d,
        (0, 39),
        "POWER OFF 5s"
    )

    bar(
        d,
        0,
        50,
        126,
        8,
        held / POWER_OFF
    )


    show(im)



def run_rescue_power():

    reset_scroll()

    deadline = (
        time.monotonic()
        + MENU_TIMEOUT
    )


    while HOTSPOT_STATE.exists():

        # ----------------------------------------------------
        # Attente dans le menu POWER
        # ----------------------------------------------------

        while not button_down():

            if (
                time.monotonic()
                >= deadline
            ):
                return

            draw_rescue_power(0)

            time.sleep(0.12)


        start = time.monotonic()


        # ----------------------------------------------------
        # Bouton maintenu
        # ----------------------------------------------------

        while button_down():

            held = (
                time.monotonic()
                - start
            )

            draw_rescue_power(
                held
            )


            # POWER OFF à 5 secondes
            if held >= POWER_OFF:

                poweroff()

                return


            time.sleep(0.05)


        held = (
            time.monotonic()
            - start
        )


        # ----------------------------------------------------
        # Clic court = retour DEPANNAGE
        # ----------------------------------------------------

        if held < SHORT_CLICK:

            return


        # ----------------------------------------------------
        # Restart entre 2 et 5 secondes
        # ----------------------------------------------------

        if held >= POWER_RESTART:

            restart_pikvm()

            return


        # Entre clic court et 2 secondes
        message(
            "Trop court",
            "2s restart / 5s off",
            1
        )

        return



def run_rescue_mode():

    # L'OLED normal ne doit PLUS tourner pendant
    # le mode dépannage.
    subprocess.run(
        [
            "systemctl",
            "stop",
            OLED_SERVICE
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

    get_device()

    reset_scroll()


    try:

        while HOTSPOT_STATE.exists():

            # =================================================
            # ECRAN PRINCIPAL DEPANNAGE
            # =================================================

            while (
                HOTSPOT_STATE.exists()
                and not button_down()
            ):

                draw_rescue(0)

                time.sleep(0.12)


            if not HOTSPOT_STATE.exists():
                break


            start = time.monotonic()


            # =================================================
            # APPUI SUR LE BOUTON
            # =================================================

            while button_down():

                held = (
                    time.monotonic()
                    - start
                )

                draw_rescue(
                    held
                )


                # ---------------------------------------------
                # 5 SECONDES
                # Retour au Wi-Fi normal
                # ---------------------------------------------

                if held >= RESCUE_TOGGLE:

                    message(
                        "DEPANNAGE OFF",
                        "Retour au WiFi...",
                        0.5
                    )

                    hotspot_toggle(False)

                    wait_release()

                    return


                time.sleep(0.05)


            held = (
                time.monotonic()
                - start
            )


            # =================================================
            # CLIC COURT
            # Ouvre uniquement le menu POWER
            # =================================================

            if held < SHORT_CLICK:

                run_rescue_power()

                reset_scroll()

                continue


            # =================================================
            # 2 -> 5 SECONDES
            # QR DU HOTSPOT
            # =================================================

            if held >= RESCUE_QR:

                env = load_hotspot()

                show_qr(
                    env.get(
                        "HOTSPOT_SSID"
                    ),
                    env.get(
                        "HOTSPOT_PASS"
                    )
                )

                reset_scroll()

                continue


            message(
                "Trop court",
                "2s QR / 5s WiFi",
                1
            )

            reset_scroll()


    finally:

        # On ne remet l'OLED normal que lorsque
        # le hotspot n'est plus actif.
        if (
            not HOTSPOT_STATE.exists()
            and not Path(
                "/run/pikvm-poweroff-requested"
            ).exists()
        ):

            subprocess.run(
                [
                    "systemctl",
                    "start",
                    OLED_SERVICE
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )


def menu_timeout(index):

    if index == 1:
        return WIFI_MENU_TIMEOUT

    if index == 3:
        return ISO_PAGE_TIMEOUT

    return MENU_TIMEOUT


def run_menu():

    global MENU_COUNTDOWN

    subprocess.run(
        [
            "systemctl",
            "stop",
            OLED_SERVICE
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

    get_device()

    index = 0

    last_action = time.monotonic()

    reset_scroll()

    MENU_COUNTDOWN = int(
        menu_timeout(index)
    )

    draw_menu(index)

    try:

        while True:

            timeout = menu_timeout(
                index
            )

            deadline = (
                last_action
                + timeout
            )

            while not button_down():

                if time.monotonic() >= deadline:
                    return

                remaining = max(
                    0,
                    int(
                        deadline
                        - time.monotonic()
                        + 0.999
                    )
                )

                MENU_COUNTDOWN = remaining

                draw_menu(index)

                time.sleep(0.12)

            start = time.monotonic()

            last_draw = 0

            action_done = False

            while button_down():

                held = (
                    time.monotonic()
                    - start
                )

                now = time.monotonic()

                if (
                    now - last_draw
                    > 0.08
                ):

                    draw_menu(
                        index,
                        held
                    )

                    last_draw = now


                # =============================================
                # POWER OFF A 5 SECONDES
                # =============================================

                if (
                    index == 0
                    and held >= POWER_OFF
                ):

                    poweroff()

                    return


                # =============================================
                # ACTIVATION HOTSPOT
                # =============================================

                if (
                    index == 2
                    and not HOTSPOT_STATE.exists()
                    and held >= RESCUE_TOGGLE
                ):

                    if hotspot_toggle(True):

                        wait_release()

                        env = load_hotspot()

                        show_qr(
                            env.get(
                                "HOTSPOT_SSID"
                            ),
                            env.get(
                                "HOTSPOT_PASS"
                            )
                        )

                        # Le hotspot est maintenant actif.
                        # On quitte complètement le menu normal.
                        # main() détectera ensuite le hotspot
                        # et lancera run_rescue_mode().
                        return

                    action_done = True

                    break


                # =============================================
                # DESACTIVATION HOTSPOT
                # =============================================

                if (
                    index == 2
                    and HOTSPOT_STATE.exists()
                    and held >= RESCUE_TOGGLE
                ):

                    hotspot_toggle(False)

                    action_done = True

                    break


                time.sleep(0.04)


            if button_down():
                wait_release()


            held = (
                time.monotonic()
                - start
            )

            last_action = time.monotonic()


            if action_done:

                draw_menu(index)

                continue


            # =============================================
            # CLIC COURT = MENU SUIVANT
            # =============================================

            if held < SHORT_CLICK:

                index = (
                    index + 1
                ) % 4

                reset_scroll()

                draw_menu(index)

                continue


            # =============================================
            # MENU POWER
            # =============================================

            if index == 0:

                if held >= POWER_RESTART:

                    restart_pikvm()

                    return

                message(
                    "Trop court",
                    "2s restart / 5s off",
                    1
                )


            # =============================================
            # MENU WIFI
            # =============================================

            elif index == 1:

                if held >= WIFI_QR:

                    ssid = current_ssid()

                    password = wifi_password(
                        ssid
                    )

                    show_qr(
                        ssid,
                        password
                    )

                else:

                    message(
                        "Trop court",
                        "Hold 2s pour QR",
                        1
                    )


            # =============================================
            # MENU DEPANNAGE
            # =============================================

            elif index == 2:

                if (
                    HOTSPOT_STATE.exists()
                    and held >= RESCUE_QR
                ):

                    env = load_hotspot()

                    show_qr(
                        env.get(
                            "HOTSPOT_SSID"
                        ),
                        env.get(
                            "HOTSPOT_PASS"
                        )
                    )

                else:

                    message(
                        "Trop court",
                        "Hold 5s",
                        1
                    )


            # =============================================
            # MENU ISO / IMG
            # =============================================

            else:

                if held >= ISO_OPEN:

                    run_iso_manager()

                else:

                    message(
                        "Trop court",
                        "Hold 2s pour gerer",
                        1,
                    )


            draw_menu(index)

            last_action = time.monotonic()


    finally:

        if (
            not Path(
                "/run/pikvm-poweroff-requested"
            ).exists()
            and not HOTSPOT_STATE.exists()
        ):

            subprocess.run(
                [
                    "systemctl",
                    "start",
                    OLED_SERVICE
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )


def main():

    button_setup()


    while True:

        # ====================================================
        # MODE DEPANNAGE ACTIF
        # ====================================================

        if HOTSPOT_STATE.exists():

            run_rescue_mode()

            button_setup()

            time.sleep(0.2)

            continue


        # ====================================================
        # MODE NORMAL
        # ====================================================

        if button_down():

            wait_release()

            run_menu()

            button_setup()

            time.sleep(0.2)


        time.sleep(0.05)


if __name__ == "__main__":
    main()
