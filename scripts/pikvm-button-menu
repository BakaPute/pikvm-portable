#!/usr/bin/env python3

import json
import re
import shlex
import shutil
import subprocess
import time
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont
from luma.core.interface.serial import i2c
from luma.oled.device import ssd1306


BUTTON = 18

MENU_TIMEOUT = 10.0
WIFI_MENU_TIMEOUT = 20.0

MENU_COUNTDOWN = None
SHORT_CLICK = 0.8

POWER_RESTART = 2.0
POWER_OFF = 5.0

WIFI_QR = 2.0

RESCUE_QR = 2.0
RESCUE_TOGGLE = 5.0

ISO_OPEN = 2.0
ISO_DELETE = 2.0
ISO_CONFIRM = 3.0

ISO_PAGE_TIMEOUT = 20.0
ISO_MANAGER_TIMEOUT = 30.0
ISO_CONFIRM_TIMEOUT = 15.0

OLED_SERVICE = "pikvm-oled-custom.service"

MSD_STORAGE = Path(
    "/var/lib/kvmd/msd"
)

MSD_LUN_FILE = Path(
    "/sys/kernel/config/usb_gadget/kvmd/"
    "functions/mass_storage.usb0/lun.0/file"
)

USB_TRANSFER_BIN = Path(
    "/usr/local/bin/pikvm-usb-transfer"
)

WPA_CONF = Path(
    "/etc/wpa_supplicant/wpa_supplicant-wlan0.conf"
)

HOTSPOT_ENV = Path(
    "/etc/kvmd/pikvm-hotspot.env"
)

HOTSPOT_STATE = Path(
    "/run/pikvm-hotspot-active"
)

QR_FILE = "/run/pikvm-oled-qr.png"

DEVICE = None

SCROLL_START = time.monotonic()


def cmd(args, timeout=10):

    p = subprocess.run(
        args,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout
    )

    return p.stdout.strip()


def button_setup():

    subprocess.run(
        ["pinctrl", "set", str(BUTTON), "ip", "pd"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )


def button_down():

    try:

        out = cmd(
            ["pinctrl", "get", str(BUTTON)],
            2
        )

        return (
            "| hi" in out
            or re.search(r"\bhi\b", out) is not None
        )

    except Exception:

        return False


def wait_release():

    while button_down():
        time.sleep(0.04)

    time.sleep(0.06)


def wait_press_until(deadline):

    while time.monotonic() < deadline:

        if button_down():

            time.sleep(0.04)

            if button_down():
                return True

        time.sleep(0.04)

    return False


def get_device():

    global DEVICE

    if DEVICE is None:

        serial = i2c(
            port=1,
            address=0x3C
        )

        DEVICE = ssd1306(
            serial,
            width=128,
            height=64
        )

    return DEVICE


def load_font(bold=False):

    if bold:

        paths = [
            "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
        ]

    else:

        paths = [
            "/usr/share/fonts/TTF/DejaVuSans.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
        ]

    for path in paths:

        if Path(path).exists():

            return ImageFont.truetype(
                path,
                9
            )

    return ImageFont.load_default()


FONT = load_font(False)
BOLD = load_font(True)


def frame():

    return Image.new(
        "1",
        (128, 64),
        0
    )


def show(image):

    get_device().display(image)


def draw_text(draw, xy, value, bold=False):

    draw.text(
        xy,
        str(value),
        font=BOLD if bold else FONT,
        fill=255
    )


def reset_scroll():

    global SCROLL_START
    SCROLL_START = time.monotonic()


def fit(value, width=124):

    value = str(value)

    im = frame()
    d = ImageDraw.Draw(im)

    # Le texte tient : aucun défilement
    if d.textbbox(
        (0, 0),
        value,
        font=FONT
    )[2] <= width:

        return value


    # 1 seconde immobile au début
    elapsed = (
        time.monotonic()
        - SCROLL_START
    )

    if elapsed < 1.0:
        position = 0

    else:
        # Une lettre environ toutes les 180 ms
        position = int(
            (elapsed - 1.0) / 0.36
        )


    # Espacement entre la fin et le début
    loop = value + "   "

    position %= len(loop)

    rotated = (
        loop[position:]
        + loop[:position]
    )


    # On prend uniquement ce qui tient
    # réellement sur la largeur disponible.
    output = ""

    for char in rotated * 2:

        test = output + char

        if d.textbbox(
            (0, 0),
            test,
            font=FONT
        )[2] > width:

            break

        output = test


    return output


def bar(draw, x, y, w, h, ratio):

    ratio = max(
        0.0,
        min(1.0, ratio)
    )

    draw.rectangle(
        (x, y, x + w, y + h),
        outline=255
    )

    fw = int(
        (w - 2) * ratio
    )

    if fw > 0:

        draw.rectangle(
            (
                x + 1,
                y + 1,
                x + 1 + fw,
                y + h - 1
            ),
            fill=255
        )


def header(draw, title, number):

    draw_text(
        draw,
        (0, 0),
        title,
        True
    )

    if MENU_COUNTDOWN is not None:

        draw_text(
            draw,
            (80, 0),
            f"{MENU_COUNTDOWN}s"
        )

    draw_text(
        draw,
        (108, 0),
        number
    )


BATTERY_CACHE_TIME = 0.0
BATTERY_CACHE_VALUE = None


def battery_percent():

    global BATTERY_CACHE_TIME
    global BATTERY_CACHE_VALUE

    now = time.monotonic()

    if (
        BATTERY_CACHE_VALUE is not None
        and now - BATTERY_CACHE_TIME < 2.0
    ):
        return BATTERY_CACHE_VALUE

    try:
        hi = int(
            cmd(
                ["i2cget", "-y", "1", "0x36", "0x02", "b"],
                2
            ),
            16
        )

        lo = int(
            cmd(
                ["i2cget", "-y", "1", "0x36", "0x03", "b"],
                2
            ),
            16
        )

        raw = (hi << 8) | lo
        voltage = raw * 78.125 / 1_000_000

        percent = (voltage - 3.10) / (4.13 - 3.10) * 100.0
        percent = max(0, min(100, percent))

        BATTERY_CACHE_VALUE = int(round(percent))
        BATTERY_CACHE_TIME = now

        return BATTERY_CACHE_VALUE

    except Exception:
        return BATTERY_CACHE_VALUE


def battery_charging():

    try:
        hi = int(
            cmd(
                ["i2cget", "-y", "1", "0x36", "0x16", "b"],
                2
            ),
            16
        )

        lo = int(
            cmd(
                ["i2cget", "-y", "1", "0x36", "0x17", "b"],
                2
            ),
            16
        )

        raw = (hi << 8) | lo

        if raw & 0x8000:
            raw -= 65536

        rate = raw * 0.208

        return rate > 0.5

    except Exception:
        return False


def current_ssid():

    if HOTSPOT_STATE.exists():
        return None

    try:

        out = cmd(
            ["iw", "dev", "wlan0", "link"],
            3
        )

        m = re.search(
            r"^\s*SSID:\s*(.+)$",
            out,
            re.M
        )

        if m:
            return m.group(1).strip()

    except Exception:
        pass

    return None


def unquote(value):

    value = value.strip()

    if (
        len(value) >= 2
        and value[0] == '"'
        and value[-1] == '"'
    ):

        value = value[1:-1]

    value = value.replace(
        r'\"',
        '"'
    )

    value = value.replace(
        r'\\',
        '\\'
    )

    return value


def wifi_password(ssid):

    if not ssid:
        return None

    if not WPA_CONF.exists():
        return None

    data = WPA_CONF.read_text(
        errors="ignore"
    )

    blocks = re.findall(
        r"network\s*=\s*\{(.*?)\}",
        data,
        re.S
    )

    for block in blocks:

        mssid = re.search(
            r'^\s*ssid\s*=\s*("(?:\\.|[^"])*")',
            block,
            re.M
        )

        if not mssid:
            continue

        if unquote(
            mssid.group(1)
        ) != ssid:

            continue

        patterns = [
            r'^\s*#psk\s*=\s*("(?:\\.|[^"])*")',
            r'^\s*psk\s*=\s*("(?:\\.|[^"])*")'
        ]

        for pattern in patterns:

            m = re.search(
                pattern,
                block,
                re.M
            )

            if m:

                return unquote(
                    m.group(1)
                )

    return None


def load_hotspot():

    values = {}

    if not HOTSPOT_ENV.exists():
        return values

    for line in HOTSPOT_ENV.read_text(
        errors="ignore"
    ).splitlines():

        line = line.strip()

        if (
            not line
            or line.startswith("#")
            or "=" not in line
        ):
            continue

        key, value = line.split(
            "=",
            1
        )

        try:

            parts = shlex.split(value)

            values[key] = (
                parts[0]
                if parts
                else ""
            )

        except Exception:

            values[key] = value.strip(
                "\"'"
            )

    return values


def wifi_escape(value):

    value = str(value)

    replacements = [
        ("\\", "\\\\"),
        (";", "\\;"),
        (",", "\\,"),
        (":", "\\:"),
        ('"', '\\"')
    ]

    for old, new in replacements:

        value = value.replace(
            old,
            new
        )

    return value

def make_wifi_qr(ssid, password):

    if not ssid or not password:
        return False

    payload = (
        "WIFI:T:WPA;"
        f"S:{wifi_escape(ssid)};"
        f"P:{wifi_escape(password)};;"
    )

    subprocess.run(
        [
            "qrencode",
            "-t", "PNG",
            "-l", "L",
            "-m", "0",
            "-s", "1",
            "-o", QR_FILE,
            payload
        ],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

    qr = Image.open(
        QR_FILE
    ).convert("1")

    # Agrandissement uniquement par facteur entier :
    # les modules du QR restent parfaitement carres.
    factor = max(
        1,
        58 // max(qr.width, qr.height)
    )

    qr = qr.resize(
        (
            qr.width * factor,
            qr.height * factor
        ),
        Image.Resampling.NEAREST
    )

    im = frame()

    # Zone blanche pour garder un QR classique noir/blanc.
    white = Image.new(
        "1",
        (64, 64),
        255
    )

    im.paste(
        white,
        (0, 0)
    )

    x = (
        64 - qr.width
    ) // 2

    y = (
        64 - qr.height
    ) // 2

    im.paste(
        qr,
        (x, y)
    )

    d = ImageDraw.Draw(im)

    draw_text(
        d,
        (68, 4),
        "SCAN WIFI",
        True
    )

    draw_text(
        d,
        (68, 20),
        fit(ssid, 58)
    )

    draw_text(
        d,
        (68, 39),
        "clic:"
    )

    draw_text(
        d,
        (68, 50),
        "retour"
    )

    show(im)

    return True


