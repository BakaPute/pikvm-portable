    show(im)


def draw_wifi(held=0):

    ssid = current_ssid()
    password = wifi_password(ssid)

    im = frame()
    d = ImageDraw.Draw(im)

    header(
        d,
        "WIFI",
        "2/4"
    )

    if not ssid:

        draw_text(
            d,
            (0, 17),
            "Non connecte"
        )

        if HOTSPOT_STATE.exists():

            draw_text(
                d,
                (0, 31),
                "Hotspot actif"
            )

    else:

        draw_text(
            d,
            (0, 13),
            "SSID: " + fit(
                ssid,
                94
            )
        )

        draw_text(
            d,
            (0, 26),
            "PASS: " + fit(
                password
                if password
                else "indisponible",
                94
            )
        )

        draw_text(
            d,
            (0, 41),
            "Hold 2s -> QR"
        )

        bar(
            d,
            0,
            54,
            126,
            7,
            held / WIFI_QR
        )

    show(im)

    return ssid, password


def draw_rescue(held=0):

    active = HOTSPOT_STATE.exists()

    env = load_hotspot()

    im = frame()
    d = ImageDraw.Draw(im)


    # ========================================================
    # HOTSPOT ACTIF = ECRAN PRINCIPAL DEPANNAGE
    # ========================================================

    if active:

        percent = battery_percent()
        charging = battery_charging()

        if percent is None:
            battery_text = "--%"
        elif charging:
            battery_text = f"C{percent}%"
        else:
            battery_text = f"{percent}%"

        # Batterie en haut à gauche
        draw_text(
            d,
            (0, 0),
            battery_text,
            True
        )

        # Titre
        draw_text(
            d,
            (31, 0),
            "DEPANNAGE",
            True
        )


        ssid = env.get(
            "HOTSPOT_SSID",
            "PiKVM-Setup"
        )

        password = env.get(
            "HOTSPOT_PASS",
            "?"
        )

        ip = env.get(
            "HOTSPOT_IP",
            "192.168.50.1"
        )


        # SSID
        draw_text(
            d,
            (0, 13),
            fit(ssid, 128),
            True
        )


        # Mot de passe
        draw_text(
            d,
            (0, 25),
            "PASS:"
        )

        draw_text(
            d,
            (31, 25),
            fit(password, 97)
        )


        # IP
        draw_text(
            d,
            (0, 37),
            "IP: " + ip
        )


        draw_text(
            d,
            (0, 48),
            "2s QR / 5s WIFI"
        )


        # Barre 0 -> 5 secondes
        bar(
            d,
            0,
            58,
            126,
            5,
            held / RESCUE_TOGGLE
        )


        # ====================================================
        # MARQUEUR A 2 SECONDES
        # 2 / 5 = 40 %
        # ====================================================

        marker_x = (
            1
            + int(
                124
                * (
                    RESCUE_QR
                    / RESCUE_TOGGLE
                )
            )
        )

        # Marqueur 2s directement dans la barre.
        # Blanc tant que la barre n'est pas arrivée à 2s,
        # puis noir lorsque le remplissage passe dessus.
        marker_color = (
            0
            if held >= RESCUE_QR
            else 255
        )

        d.line(
            (
                marker_x,
                59,
                marker_x,
                62
            ),
            fill=marker_color
        )


    # ========================================================
    # MODE NORMAL : MENU 3/3 EXISTANT
    # ========================================================

    else:

        header(
            d,
            "DEPANNAGE",
            "3/4"
        )

        draw_text(
            d,
            (0, 16),
            "Hotspot: OFF"
        )

        draw_text(
            d,
            (0, 31),
            "Hold 5s -> ON"
        )

        bar(
            d,
            0,
            48,
            126,
            9,
            held / RESCUE_TOGGLE
        )


    show(im)



# ------------------------------------------------------------
# Gestionnaire ISO / IMG
# ------------------------------------------------------------

def image_files():

    extensions = (
        ".iso",
        ".img",
        ".raw",
    )

    try:

        files = [
            path
            for path in MSD_STORAGE.iterdir()
            if (
                path.is_file()
                and not path.is_symlink()
                and not path.name.startswith(".")
                and path.name.lower().endswith(
                    extensions
                )
            )
        ]

        return sorted(
            files,
            key=lambda path: path.name.lower()
        )

    except Exception:

        return []


def image_size(path):

    try:

        size = path.stat().st_size

        gib = size / (1024 ** 3)

        if gib >= 1:
            return f"{gib:.2f} GiB"

        mib = size / (1024 ** 2)

        return f"{mib:.1f} MiB"

    except Exception:

        return "? MiB"


def storage_free():

    try:

        free = shutil.disk_usage(
            MSD_STORAGE
        ).free

        gib = free / (1024 ** 3)

        return f"{gib:.0f}G"

    except Exception:

        return "?G"


def drive_connected():

    try:

        return bool(
            MSD_LUN_FILE.read_text().strip()
        )

    except Exception:

        return False


def usb_transfer_busy():

    if not USB_TRANSFER_BIN.exists():
        return False

    try:

        out = cmd(
            [
                str(USB_TRANSFER_BIN),
                "status",
            ],
            3,
        )

        data = json.loads(out)

        state = data.get(
            "state",
            "idle",
        )

        drive = data.get(
            "drive",
            {},
        )

        return (
            bool(
                drive.get(
                    "transfer_active",
                    False,
                )
            )
            or state in {
                "starting",
                "connected",
                "stopping",
                "importing",
                "preparing",
            }
        )

    except Exception:

        return False


def delete_image(path):

    # --------------------------------------------------------
    # Sécurités
    # --------------------------------------------------------

    if usb_transfer_busy():

        return (
            False,
            "Transfert USB actif",
        )

    if drive_connected():

        return (
            False,
            "Drive connecte",
        )

    try:

        root = MSD_STORAGE.resolve()
        target = path.resolve()

        if target.parent != root:

            return (
                False,
                "Chemin refuse",
            )

        if target.name.startswith("."):

            return (
                False,
                "Image protegee",
            )

        if not target.exists():

            return (
                False,
                "Image absente",
            )

    except Exception as e:

        return (
            False,
            str(e),
        )


    # --------------------------------------------------------
    # Suppression
    # --------------------------------------------------------

    try:

        subprocess.run(
            [
                "kvmd-helper-otgmsd-remount",
                "rw",
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )

        try:

            target.unlink()

            subprocess.run(
                ["sync"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )

        finally:

            subprocess.run(
                [
                    "kvmd-helper-otgmsd-remount",
                    "ro",
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )

        return (
            True,
            "Image supprimee",
        )

    except Exception as e:

        try:

            subprocess.run(
                [
                    "kvmd-helper-otgmsd-remount",
                    "ro",
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )

        except Exception:

            pass

        return (
            False,
            str(e),
        )


def draw_iso_page(held=0):

    images = image_files()

    im = frame()
    d = ImageDraw.Draw(im)

    header(
        d,
        "ISO / IMG",
        "4/4",
    )

    draw_text(
        d,
        (0, 16),
        f"Images: {len(images)}",
    )

    if usb_transfer_busy():

        draw_text(
            d,
            (0, 31),
            "Transfert USB actif",
        )

    else:

        draw_text(
            d,
            (0, 31),
            "Hold 2s -> gerer",
        )

    bar(
        d,
        0,
        49,
        126,
        9,
        held / ISO_OPEN,
    )

    show(im)


def draw_iso_browser(
    images,
    index,
    held=0,
    remaining=None,
):

    image = images[index]

    im = frame()
    d = ImageDraw.Draw(im)

    draw_text(
        d,
        (0, 0),
        "ISO / IMG",
        True,
    )

    if remaining is not None:

        draw_text(
            d,
            (76, 0),
            f"{remaining}s",
        )

    draw_text(
        d,
        (105, 0),
        f"{index + 1}/{len(images)}",
    )

    draw_text(
        d,
        (0, 14),
        fit(
            image.name,
            126,
        ),
        True,
    )

    size_text = image_size(
        image
    ).replace(
        " GiB",
        "G"
    ).replace(
        " MiB",
        "M"
    )

    draw_text(
        d,
        (0, 29),
        f"{size_text}   Libre {storage_free()}",
    )

    draw_text(
        d,
        (0, 41),
        "clic: suivant",
    )

    draw_text(
        d,
        (0, 52),
        "2s: supprimer",
    )

    if held > 0:

        bar(
            d,
            82,
            53,
            44,
            7,
            held / ISO_DELETE,
        )

    show(im)


