#!/usr/bin/env python3
"""Compatibility guard: defer native MSD remount-ro while SHARE owns a lease."""
import fcntl
import os
from pathlib import Path
import subprocess
import sys

# Preserve the basename: KVMD selects MSD versus PST using sys.argv[0].
ORIGINAL = '/usr/local/lib/pikvm-share/native/kvmd-helper-otgmsd-remount'
LEASE = Path('/run/pikvm-share/lease.json')
LOCK = '/run/pikvm-share-storage.lock'


def main():
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'r+') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        # Native helper accepts rw/ro. Preserve all other arguments exactly,
        # including invalid invocations, and never fake a successful RW.
        if sys.argv[1:] == ['ro'] and LEASE.exists():
            return 0
        return subprocess.run([ORIGINAL, *sys.argv[1:]], check=False).returncode


if __name__ == '__main__':
    raise SystemExit(main())
